{
  "name": "mossferry",
  "version": "2.9.0",
  "description": "The green ferry between your machines \u2014 open remote tmux sessions over mosh/ssh with a fzf picker.",
  "bin": {
    "mossferry": "bin/mossferry",
    "ferry": "bin/mossferry",
    "repo-session": "bin/repo-session"
  },
  "files": [
    "bin",
    "lib",
    "config.example",
    "VERSION",
    "install.sh",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "os": [
    "!win32"
  ],
  "scripts": {
    "test": "bash tests/run.sh",
    "docs:check": "node ../docs-kit/bin/docs-kit.mjs check docs/",
    "docs:health": "node ../docs-kit/bin/docs-kit.mjs health docs/",
    "atlas": "atlas",
    "atlas:gate": "atlas gate",
    "atlas:doctor": "atlas doctor",
    "atlas:wire": "atlas wire all",
    "predev": "atlas gate",
    "mind:check": "atlas check",
    "mind:build": "atlas build",
    "//sage-gate": "global only \u2014 sage gate (preferred judge) is machine-level; not chained into predev. run: sage gate"
  },
  "keywords": [
    "mosh",
    "ssh",
    "tmux",
    "remote",
    "session",
    "fzf",
    "cli",
    "ferry"
  ],
  "author": "Mateusz Mu\u015blewski <10kento10@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muslewski/mossferry.git"
  },
  "bugs": {
    "url": "https://github.com/muslewski/mossferry/issues"
  },
  "homepage": "https://mossferry.muslewski.com/",
  "devDependencies": {
    "memory-atlas": "0.5.3"
  }
}
