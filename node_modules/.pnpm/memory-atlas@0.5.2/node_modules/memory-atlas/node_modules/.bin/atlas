#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/kento/Repositories/mossferry/node_modules/.pnpm/memory-atlas@0.5.2/node_modules/memory-atlas/bin/node_modules:/home/kento/Repositories/mossferry/node_modules/.pnpm/memory-atlas@0.5.2/node_modules/memory-atlas/node_modules:/home/kento/Repositories/mossferry/node_modules/.pnpm/memory-atlas@0.5.2/node_modules:/home/kento/Repositories/mossferry/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/kento/Repositories/mossferry/node_modules/.pnpm/memory-atlas@0.5.2/node_modules/memory-atlas/bin/node_modules:/home/kento/Repositories/mossferry/node_modules/.pnpm/memory-atlas@0.5.2/node_modules/memory-atlas/node_modules:/home/kento/Repositories/mossferry/node_modules/.pnpm/memory-atlas@0.5.2/node_modules:/home/kento/Repositories/mossferry/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/atlas.mjs" "$@"
else
  exec node  "$basedir/../../bin/atlas.mjs" "$@"
fi
