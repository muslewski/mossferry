#!/usr/bin/env bash
# repo-session [repo] [flags] [-- cmd...]
# Remote brain for mossferry: picker, attach/create, atomic grid claim.
#   (default)           fzf/menu picker (scoped to <repo> when given)
#   --primary / -p      attach primary session, create if missing
#   --new               force a fresh session (repo, repo-2, ...)
#   --list / -l         list live sessions and exit
#   --resume [N|name]   bare → picker; N/name → direct attach
#   --resume-closed     atomic claim of one existing session
#   --resume-or-new     claim, or create if none left
#   --claude / -c       run claude on creation
#   --client-version V  version handshake with local mossferry client
#   --validate <repo>   exit 0 if repo dir exists under base; else error (no tmux)
#   --help / -h         usage
#   -- cmd...           custom startup command on creation
# shellcheck disable=SC1090,SC1091
set -u

# Resolve tmux from PATH first (Homebrew on macOS is not under /usr/bin).
# Absolute path below is last-resort so Linux installs keep working.
TMUXBIN="${REPO_SESSION_TMUXBIN:-$(command -v tmux 2>/dev/null || printf '/usr/bin/tmux')}"

# Populated by parse_launchers (after load_config). Empty = feature off.
LAUNCHER_KEYS=()
LAUNCHER_CMDS=()
# Populated by parse_start_menu — nested create-menu entries (no hotkeys).
START_MENU_CMDS=()

# Symlink-safe path resolution (stock macOS bash 3.2 + Linux).
# Never depends on GNU `readlink -f`.
_ferry_resolve_self() {
  local src="${1:-${BASH_SOURCE[0]}}"
  local dir link max=50
  case "$src" in
    /*) ;;
    *) src="$(pwd)/$src" ;;
  esac
  while [ -L "$src" ] && [ "$max" -gt 0 ]; do
    dir=$(cd "$(dirname "$src")" && pwd) || return 1
    link=$(readlink "$src") || return 1
    case "$link" in
      /*) src=$link ;;
      *) src=$dir/$link ;;
    esac
    max=$((max - 1))
  done
  printf '%s\n' "$src"
}

_ferry_repo_root() {
  local self
  self=$(_ferry_resolve_self "${BASH_SOURCE[0]}") || return 1
  cd "$(dirname "$self")/.." && pwd
}

REPO_ROOT="$(_ferry_repo_root)"

# ---- servers view (lib/servers.sh) — missing lib degrades to empty ----------
_ferry_load_servers() {
  local s="${REPO_ROOT}/lib/servers.sh"
  if [[ -r "$s" ]]; then
    # shellcheck source=lib/servers.sh
    source "$s" || true
  fi
  # Stubs if lib absent so picker still runs
  if ! declare -F build_server_rows >/dev/null 2>&1; then
    build_server_rows() { return 0; }
    servers_mac_state() { printf 'unknown\n'; }
    servers_fix_plan() { printf 'none\tn/a\n'; }
  fi
}
_ferry_load_servers

# ---- GREEN-UI-KIT (vendored) — missing lib must NEVER kill the tool --------
_ferry_ui_fallbacks() {
  detect_color() { printf 'none\n'; }
  ui_tty() {
    case ${GREEN_UI_FORCE_TTY-} in
      1) return 0 ;;
      0) return 1 ;;
    esac
    [[ -t 2 ]]
  }
  ui_init() {
    GREEN_UI_MODE=none
    UI_R= UI_G= UI_Y= UI_B= UI_C= UI_M= UI_D= UI_BOLD= UI_Z= UI_A=
    UI_OK='OK' UI_ERR='XX' UI_WARN='!!' UI_PEND='..' UI_RUN='>>'
    UI_SPIN=('|' '/' '-' '\')
    return 0
  }
  banner() {
    local title=${1-} subtitle=${2-}
    printf '+-- %s --+\n' "$title" >&2
    [[ -n $subtitle ]] && printf '| %s\n' "$subtitle" >&2
  }
  ok()   { printf 'OK %s\n' "$*" >&2; }
  warn() { printf '!! %s\n' "$*" >&2; }
  die()  { printf 'XX %s\n' "${1-error}" >&2; exit "${2:-1}"; }
  panel() {
    local title=${1-} line
    printf '+-- %s --+\n' "$title" >&2
    while IFS= read -r line || [[ -n $line ]]; do
      printf '| %s\n' "$line" >&2
    done
    printf '+--------+\n' >&2
  }
  ui_cleanup() { return 0; }
}

_ferry_load_ui() {
  local kit="${REPO_ROOT}/lib/green-ui.sh"
  if [[ -r "$kit" ]]; then
    # shellcheck source=lib/green-ui.sh
    source "$kit" || _ferry_ui_fallbacks
  else
    _ferry_ui_fallbacks
  fi
  ui_init
}

_ferry_load_ui

# Remote error line: always `repo-session:` prefix; red ✗ when TTY.
_rs_err() {
  if ui_tty 2>/dev/null; then
    printf '%s%s%s repo-session: %s\n' "${UI_R-}" "${UI_ERR-✗}" "${UI_Z-}" "$*" >&2
  else
    printf 'repo-session: %s\n' "$*" >&2
  fi
}

# Fail early with an actionable message when tmux is missing (stock macOS has
# none; Homebrew installs under /opt/homebrew or /usr/local).
# Uses die() from green-ui (or the fallback defined above).
_require_tmux() {
  if [[ -x "$TMUXBIN" ]]; then
    return 0
  fi
  # Relative names / PATH hits: re-resolve once.
  local resolved
  resolved=$(command -v "$TMUXBIN" 2>/dev/null) || true
  if [[ -n "$resolved" && -x "$resolved" ]]; then
    TMUXBIN="$resolved"
    return 0
  fi
  die "tmux not found on PATH (looked for: ${TMUXBIN}).
macOS: brew install tmux   ·   or set REPO_SESSION_TMUXBIN=/path/to/tmux"
}

# ---- config / version helpers ------------------------------------------------

load_config() {
  # Snapshot env (env > file > default).
  local e_REMOTE_BIN e_REPO_BASE e_DEFAULT_CMD e_DEFAULT_HOST e_SERVER_TIMEOUT e_REMOTE_REPO
  local e_HIDDEN_WINDOW_GLOB e_BANNER e_LAUNCHERS e_START_MENU e_SAGE
  e_REMOTE_BIN="${FERRY_REMOTE_BIN-__UNSET__}"
  e_REPO_BASE="${FERRY_REPO_BASE-__UNSET__}"
  e_DEFAULT_CMD="${FERRY_DEFAULT_CMD-__UNSET__}"
  e_DEFAULT_HOST="${FERRY_DEFAULT_HOST-__UNSET__}"
  e_SERVER_TIMEOUT="${FERRY_SERVER_TIMEOUT-__UNSET__}"
  e_REMOTE_REPO="${FERRY_REMOTE_REPO-__UNSET__}"
  e_HIDDEN_WINDOW_GLOB="${FERRY_HIDDEN_WINDOW_GLOB-__UNSET__}"
  e_BANNER="${FERRY_BANNER-__UNSET__}"
  e_LAUNCHERS="${FERRY_LAUNCHERS-__UNSET__}"
  e_START_MENU="${FERRY_START_MENU-__UNSET__}"
  e_SAGE="${FERRY_SAGE-__UNSET__}"

  FERRY_REMOTE_BIN=".local/bin/repo-session"
  FERRY_REPO_BASE="${HOME}/Repositories"
  FERRY_DEFAULT_CMD="neofetch"
  FERRY_DEFAULT_HOST=""
  FERRY_SERVER_TIMEOUT="86400"
  FERRY_REMOTE_REPO="Repositories/mossferry"
  FERRY_HIDDEN_WINDOW_GLOB="_*"
  FERRY_BANNER="on"
  # Nested create menu (generic CLI names only — put personal profiles in user config).
  FERRY_START_MENU="claude,grok"
  # Optional hotkeys; empty by default (prefer the nested menu). Set e.g.
  # ctrl-a:claude,ctrl-g:grok for power-user chords. Personal wallet names
  # belong in the user's config file, never in shipped defaults.
  FERRY_LAUNCHERS=""
  # Optional agentic-sage wire: auto when `sage` on PATH; off|0|false|no hard-kills.
  FERRY_SAGE="auto"

  if [[ -r "${HOME}/.config/mossferry/config" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.config/mossferry/config"
  fi

  [[ "$e_REMOTE_BIN" != "__UNSET__" ]] && FERRY_REMOTE_BIN="$e_REMOTE_BIN"
  [[ "$e_REPO_BASE" != "__UNSET__" ]] && FERRY_REPO_BASE="$e_REPO_BASE"
  [[ "$e_DEFAULT_CMD" != "__UNSET__" ]] && FERRY_DEFAULT_CMD="$e_DEFAULT_CMD"
  [[ "$e_DEFAULT_HOST" != "__UNSET__" ]] && FERRY_DEFAULT_HOST="$e_DEFAULT_HOST"
  [[ "$e_SERVER_TIMEOUT" != "__UNSET__" ]] && FERRY_SERVER_TIMEOUT="$e_SERVER_TIMEOUT"
  [[ "$e_REMOTE_REPO" != "__UNSET__" ]] && FERRY_REMOTE_REPO="$e_REMOTE_REPO"
  [[ "$e_HIDDEN_WINDOW_GLOB" != "__UNSET__" ]] && FERRY_HIDDEN_WINDOW_GLOB="$e_HIDDEN_WINDOW_GLOB"
  [[ "$e_BANNER" != "__UNSET__" ]] && FERRY_BANNER="$e_BANNER"
  [[ "$e_LAUNCHERS" != "__UNSET__" ]] && FERRY_LAUNCHERS="$e_LAUNCHERS"
  [[ "$e_START_MENU" != "__UNSET__" ]] && FERRY_START_MENU="$e_START_MENU"
  [[ "$e_SAGE" != "__UNSET__" ]] && FERRY_SAGE="$e_SAGE"
}

# Hybrid sage adapter: auto when sage on PATH; FERRY_SAGE=off hard-kills.
# Never blocks picker when sage is broken — callers must tolerate failure.
_ferry_sage_enabled() {
  case "${FERRY_SAGE:-auto}" in
    off|0|false|no|OFF|FALSE|NO) return 1 ;;
  esac
  command -v sage >/dev/null 2>&1 || return 1
  return 0
}

# Parse FERRY_LAUNCHERS into LAUNCHER_KEYS / LAUNCHER_CMDS (parallel arrays).
# Empty value → both empty (feature off). Invalid/reserved pairs skipped.
# Split each pair on the FIRST colon so commands may contain args/spaces.
parse_launchers() {
  LAUNCHER_KEYS=()
  LAUNCHER_CMDS=()
  local raw="${FERRY_LAUNCHERS:-}"
  [[ -z "$raw" ]] && return 0

  local pair key cmd
  # Trailing newline so the last pair is not dropped by `read`.
  while IFS= read -r pair || [[ -n "${pair:-}" ]]; do
    [[ -z "$pair" ]] && continue
    [[ "$pair" != *:* ]] && continue
    key="${pair%%:*}"
    cmd="${pair#*:}"
    [[ -z "$key" || -z "$cmd" ]] && continue
    # Reserved for kill/rename in the main picker.
    [[ "$key" == "ctrl-x" || "$key" == "ctrl-r" || "$key" == "ctrl-s" || "$key" == "ctrl-f" ]] && continue
    # Valid fzf-bindable keys only.
    if [[ "$key" =~ ^ctrl-[a-z]$ ]] \
       || [[ "$key" =~ ^alt-[a-z]$ ]] \
       || [[ "$key" =~ ^f([1-9]|1[0-2])$ ]]; then
      LAUNCHER_KEYS+=("$key")
      LAUNCHER_CMDS+=("$cmd")
    fi
  done < <(printf '%s\n' "$raw" | tr ',' '\n')
}

# Parse FERRY_START_MENU into START_MENU_CMDS (deduped, non-empty).
# Comma-separated bare commands (may contain spaces/args; no commas inside a cmd).
parse_start_menu() {
  START_MENU_CMDS=()
  local raw="${FERRY_START_MENU:-}" item
  [[ -z "$raw" ]] && return 0
  while IFS= read -r item || [[ -n "${item:-}" ]]; do
    # trim leading/trailing whitespace
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -z "$item" ]] && continue
    local seen=0 c
    for c in "${START_MENU_CMDS[@]+"${START_MENU_CMDS[@]}"}"; do
      [[ "$c" == "$item" ]] && { seen=1; break; }
    done
    (( seen )) && continue
    START_MENU_CMDS+=("$item")
  done < <(printf '%s\n' "$raw" | tr ',' '\n')
}

# Print the start command for a launcher key. Exit 1 if unknown.
launcher_cmd() {
  local want="${1:-}" i
  [[ -z "$want" ]] && return 1
  for i in "${!LAUNCHER_KEYS[@]}"; do
    if [[ "${LAUNCHER_KEYS[$i]}" == "$want" ]]; then
      printf '%s\n' "${LAUNCHER_CMDS[$i]}"
      return 0
    fi
  done
  return 1
}

# Comma-separated --expect list: ctrl-x,ctrl-r[,launcher keys...]
_launcher_expect_suffix() {
  local k out=""
  for k in "${LAUNCHER_KEYS[@]+"${LAUNCHER_KEYS[@]}"}"; do
    out+=",$k"
  done
  printf '%s' "$out"
}

# Sub-picker hints: enter=start menu (or default) · optional hotkeys
_subpicker_hints() {
  local i line
  if (( ${#START_MENU_CMDS[@]} > 0 )); then
    line="enter=start menu"
  else
    line="enter=${FERRY_DEFAULT_CMD:-neofetch}"
  fi
  for i in "${!LAUNCHER_KEYS[@]}"; do
    line+=" · ${LAUNCHER_KEYS[$i]}=${LAUNCHER_CMDS[$i]}"
  done
  printf '%s' "$line"
}

# Nested fzf/menu: pick how a *new* session starts.
# Prints the chosen command on stdout. Exit 1 on cancel.
# Skipped by caller when startcmd already armed (hotkey / --claude / -- cmd).
_pick_start_cmd() {
  local def="${FERRY_DEFAULT_CMD:-neofetch}"
  local -a opts=()
  local c choice i pickfile
  local def_label="default (no AI) — ${def}"

  opts+=("$def_label")
  for c in "${START_MENU_CMDS[@]+"${START_MENU_CMDS[@]}"}"; do
    [[ "$c" == "$def" ]] && continue
    opts+=("$c")
  done
  # Also surface unique hotkey commands so the menu is the single source of truth
  # even when the user only configured FERRY_LAUNCHERS.
  for c in "${LAUNCHER_CMDS[@]+"${LAUNCHER_CMDS[@]}"}"; do
    [[ "$c" == "$def" ]] && continue
    local seen=0 o
    for o in ${opts[@]+"${opts[@]}"}; do
      [[ "$o" == "$c" ]] && { seen=1; break; }
    done
    (( seen )) && continue
    opts+=("$c")
  done

  # Only default row → no real menu.
  if (( ${#opts[@]} <= 1 )); then
    printf '%s\n' "$def"
    return 0
  fi

  if command -v fzf >/dev/null 2>&1 && [[ -z "${FERRY_NO_FZF:-}" ]]; then
    pickfile="${TMPDIR:-/tmp}/repo-session-start.$$"
    printf '%s\n' ${opts[@]+"${opts[@]}"} | fzf --layout=reverse --header-first --cycle \
      --header "start command · enter=pick · esc=cancel" \
      --prompt='start> ' >"$pickfile" || { rm -f "$pickfile"; [[ -n "${facefile:-}" ]] && rm -f "$facefile" "$facefile"; return 1; }
    choice=$(cat "$pickfile")
    rm -f "$pickfile"; [[ -n "${facefile:-}" ]] && rm -f "$facefile"
  else
    # Numbered fallback — read stdin (same as other no-fzf menus; tests pipe here).
    i=1
    for o in ${opts[@]+"${opts[@]}"}; do
      printf '%d) %s\n' "$i" "$o" >&2
      ((i++)) || true
    done
    printf 'q) cancel\n' >&2
    if ! read -r choice; then
      return 1
    fi
    case "$choice" in
      q|Q|"") return 1 ;;
      *)
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#opts[@]} )); then
          choice="${opts[$((choice-1))]}"
        else
          return 1
        fi
        ;;
    esac
  fi
  [[ -z "$choice" ]] && return 1
  if [[ "$choice" == "$def_label" || "$choice" == default* ]]; then
    printf '%s\n' "$def"
  else
    printf '%s\n' "$choice"
  fi
  return 0
}

# ASCII ferry art for picker header / --help / no-fzf menu.
# Keep in sync with bin/mossferry (deliberate duplication — both scripts stay self-contained).
# Optional arg = available display columns; default COLUMNS / tput / 80.
# Tiers: off→nothing; rows<18→SMALL; width≥52→WIDE; width≥24→MEDIUM; else SMALL.
ferry_banner() {
  case "${FERRY_BANNER:-on}" in
    off|0) return 0 ;;
  esac
  local rows width
  rows="${LINES:-$(tput lines 2>/dev/null || echo 24)}"
  width="${1:-${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}}"
  if (( rows < 18 )); then
    # Short panes: one-line variant (green name).
    printf '⛴ \033[1;32mmossferry\033[0m\n'
    return 0
  fi
  if (( width >= 52 )); then
    # WIDE: boat + figlet-wordmark lockup (6×51).
    # flag bright green; boat structure regular green; portholes/waves dim; figlet bright.
    printf '           \033[1;32m|>\033[0m\n'
    printf '\033[32m         __|__               \033[0m\033[1;32m__\033[0m\n'
    printf '\033[32m      __|_\033[0m\033[2;32mo\033[0m\033[32m_\033[0m\033[2;32mo\033[0m\033[32m_|__           \033[0m\033[1;32m/ _|___ _ _ _ _ _  _\033[0m\n'
    printf '\033[32m    _|___________|_        \033[0m\033[1;32m|  _/ -_) '"'"'_| '"'"'_| || |\033[0m\n'
    printf '\033[32m   \\   \033[0m\033[2;32mo\033[0m\033[32m   \033[0m\033[2;32mo\033[0m\033[32m   \033[0m\033[2;32mo\033[0m\033[32m   /       \033[0m\033[1;32m|_| \\___|_| |_|  \\_, |\033[0m\n'
    printf '\033[2;32m ~~~\033[0m\033[32m\\_____________/\033[0m\033[2;32m~~~~~~~~~~~~~~~~~~~~~~~~\033[0m\033[1;32m |__/\033[0m\033[2;32m ~~\033[0m\n'
    return 0
  fi
  if (( width >= 24 )); then
    # MEDIUM: boat liner with name on hull (6×22).
    printf '           \033[1;32m|>\033[0m\n'
    printf '\033[32m         __|__\033[0m\n'
    printf '\033[32m      __|_\033[0m\033[2;32mo\033[0m\033[32m_\033[0m\033[2;32mo\033[0m\033[32m_|__\033[0m\n'
    printf '\033[32m    _|___________|_\033[0m\n'
    printf '\033[32m   \\   \033[0m\033[1;32mmossferry\033[0m\033[32m   /\033[0m\n'
    printf '\033[2;32m ~~~\033[0m\033[32m\\_____________/\033[0m\033[2;32m~~~\033[0m\n'
    return 0
  fi
  # Narrow but tall: SMALL one-liner.
  printf '⛴ \033[1;32mmossferry\033[0m\n'
}

# Repo token shape: single path segment, no traversal. Matches create_repo allow-list.
# Shared shape gate (same definition as the laptop client).
_ferry_load_repo_token() {
  local f="${REPO_ROOT}/lib/repo-token.sh"
  if [[ -r "$f" ]]; then
    # shellcheck source=lib/repo-token.sh
    source "$f" || true
  fi
  if ! declare -F _ferry_repo_token_ok >/dev/null 2>&1; then
    # Inline fallback if lib is missing (e.g. partial install).
    _ferry_repo_token_ok() {
      local r=${1-}
      [[ -n "$r" ]] || return 1
      case "$r" in
        /*|*/*|*\\*|*..*) return 1 ;;
      esac
      [[ "$r" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
      return 0
    }
    _ferry_repo_token_reject_msg() {
      local r=${1-}
      printf "repo-session: invalid repo name '%s'\n" "${r//\'/}" >&2
    }
  fi
}
_ferry_load_repo_token

# Safe lock/claim filename fragment (no path separators).
_ferry_claim_lockf() {
  local repo=${1-}
  local safe
  safe=$(printf '%s' "$repo" | tr -c 'A-Za-z0-9._-' '_')
  [[ -n "$safe" ]] || safe="unknown"
  printf '%s\n' "${TMPDIR:-/tmp}/repo-session-${safe}.claim"
}

# Portable exclusive lock for claim/create paths.
# Linux: flock on fd 9 (same as before).
# macOS / no util-linux: atomic mkdir mutex (mkdir is atomic on POSIX fs;
# pattern mirrors lib/fleet-devlog.sh EEXIST handling). Stale recovery via
# PID liveness (kill -0); if the holder is alive we wait up to 30s then die
# — never proceed unlocked.
_FERRY_LOCK_KIND=""   # flock | mkdir | empty
_FERRY_LOCK_DIR=""    # set when kind=mkdir

_ferry_lock_acquire() {
  local lockf=${1-}
  local lockdir pidfile holder waited max_wait=30

  [[ -n "$lockf" ]] || die "repo-session: lock path required"

  if command -v flock >/dev/null 2>&1; then
    # Keep fd 9 open for the critical section (matches prior exec 9>"$lockf").
    exec 9>"$lockf" || die "repo-session: cannot open lock file ${lockf}"
    flock 9 || die "repo-session: cannot acquire lock ${lockf}"
    _FERRY_LOCK_KIND=flock
    _FERRY_LOCK_DIR=""
    return 0
  fi

  # mkdir mutex fallback (no flock on stock macOS).
  lockdir="${lockf}.lockdir"
  pidfile="${lockdir}/pid"
  waited=0
  while true; do
    if mkdir "$lockdir" 2>/dev/null; then
      # Write holder pid; if write fails, drop the dir so others are not stuck.
      if ! printf '%s\n' "$$" >"$pidfile" 2>/dev/null; then
        rmdir "$lockdir" 2>/dev/null || true
        die "repo-session: cannot write lock pid ${pidfile}"
      fi
      _FERRY_LOCK_KIND=mkdir
      _FERRY_LOCK_DIR=$lockdir
      # Release on signal / unexpected exit (normal path calls _ferry_lock_release).
      trap '_ferry_lock_release' EXIT INT TERM HUP
      return 0
    fi
    # Held or leftover from a crashed run — reclaim only if holder is dead.
    holder=""
    if [[ -f "$pidfile" ]]; then
      holder=$(cat "$pidfile" 2>/dev/null || true)
      holder=${holder%%[!0-9]*}
    fi
    if [[ -z "$holder" ]] || ! kill -0 "$holder" 2>/dev/null; then
      # Stale: no pid, or process gone. Best-effort reclaim (dir only holds pid).
      rm -f "$pidfile" 2>/dev/null || true
      rmdir "$lockdir" 2>/dev/null || true
      # If rmdir failed (not empty / race), fall through to wait+retry.
      continue
    fi
    waited=$((waited + 1))
    if (( waited >= max_wait )); then
      die "repo-session: timeout acquiring lock ${lockdir} (held by pid ${holder})"
    fi
    sleep 1
  done
}

_ferry_lock_release() {
  local kind=${_FERRY_LOCK_KIND-} dir=${_FERRY_LOCK_DIR-}
  _FERRY_LOCK_KIND=""
  _FERRY_LOCK_DIR=""
  case "$kind" in
    flock)
      # portable-ok: reached only when _FERRY_LOCK_KIND=flock, which is set inside
      # the `command -v flock` branch of _ferry_lock_acquire — guarded by control
      # flow, not by a guard on this line.
      flock -u 9 2>/dev/null || true
      ;;
    mkdir)
      # Clear trap first so EXIT during release does not recurse.
      trap - EXIT INT TERM HUP
      if [[ -n "$dir" ]]; then
        rm -f "${dir}/pid" 2>/dev/null || true
        rmdir "$dir" 2>/dev/null || true
      fi
      ;;
  esac
  return 0
}

# Fixed-string session name match for a repo (no regex interpolation of $repo).
# Matches: exact name (optional trailing space), name-N digits, ccops-name-*.
_ferry_session_matches_repo() {
  local s=${1-} filter=${2-}
  local trimmed=$s
  [[ -n "$filter" ]] || return 1
  # Strip trailing whitespace without extglob.
  while [[ "$trimmed" == *[[:space:]] ]]; do
    trimmed=${trimmed%?}
  done
  if [[ "$trimmed" == "$filter" ]]; then
    return 0
  fi
  if [[ "$trimmed" == "$filter"-* ]]; then
    local suffix=${trimmed#"$filter"-}
    [[ "$suffix" =~ ^[0-9]+$ ]] && return 0
  fi
  if [[ "$s" == ccops-"$filter"-* ]]; then
    return 0
  fi
  return 1
}

# List session names for $filter via fixed-string match (never grep -E with repo).
_ferry_list_sessions_for_repo() {
  local filter=${1-} s
  while IFS= read -r s; do
    [[ -z "$s" ]] && continue
    _ferry_session_matches_repo "$s" "$filter" && printf '%s\n' "$s"
  done < <("$TMUXBIN" list-sessions -F '#{session_name}' 2>/dev/null | sort -V)
}

# Closest repo name for did-you-mean (prefix / substring / common-prefix score).
_ferry_closest_repo() {
  local want=$1
  shift
  local cand best="" best_score=-1 score i m
  local wlen=${#want}
  (( wlen == 0 )) && return 1
  for cand in "$@"; do
    score=0
    if [[ "$cand" == "$want" ]]; then
      printf '%s\n' "$cand"
      return 0
    fi
    # prefix either way
    if [[ "$cand" == "$want"* ]]; then
      score=$((100 + ${#want}))
    elif [[ "$want" == "$cand"* ]]; then
      score=$((90 + ${#cand}))
    elif [[ "$cand" == *"$want"* ]]; then
      score=$((50 + ${#want}))
    elif [[ "$want" == *"$cand"* ]]; then
      score=$((40 + ${#cand}))
    else
      m=$wlen
      (( ${#cand} < m )) && m=${#cand}
      score=0
      for (( i = 0; i < m; i++ )); do
        if [[ "${cand:i:1}" == "${want:i:1}" ]]; then
          score=$((score + 1))
        else
          break
        fi
      done
      # length proximity bonus for 1-char typos
      local d=$(( ${#cand} - wlen ))
      (( d < 0 )) && d=$(( -d ))
      if (( d <= 1 && score >= 3 )); then
        score=$((score + 20))
      fi
    fi
    if (( score > best_score )); then
      best_score=$score
      best=$cand
    fi
  done
  # require a minimum signal so random names don't get silly hints
  if [[ -n "$best" ]] && (( best_score >= 3 )); then
    printf '%s\n' "$best"
    return 0
  fi
  return 1
}

# Exit 0 if $FERRY_REPO_BASE/<repo> is a directory; else stderr error + list, return 1.
# Never invokes tmux.
# PARSE-TOKEN: first error line is byte-stable. TTY adds dim capped list + did-you-mean.
validate_repo() {
  local r="$1"
  # Containment: reject path-shaped tokens before joining with FERRY_REPO_BASE.
  if ! _ferry_repo_token_ok "$r"; then
    _ferry_repo_token_reject_msg "$r"
    return 1
  fi
  local dir="${FERRY_REPO_BASE}/${r}"
  # After join, require realpath under base when realpath exists.
  if [[ -d "$dir" ]] && command -v realpath >/dev/null 2>&1; then
    local base_real dir_real
    base_real=$(realpath -- "$FERRY_REPO_BASE" 2>/dev/null) || true
    dir_real=$(realpath -- "$dir" 2>/dev/null) || true
    if [[ -n "$base_real" && -n "$dir_real" ]]; then
      case "$dir_real" in
        "$base_real"|"$base_real"/*) ;;
        *)
          echo "repo-session: no repo '${r//\'/}' under ${FERRY_REPO_BASE} — pick one below, or run 'ferry <host>' to browse all sessions" >&2
          return 1
          ;;
      esac
    fi
  fi
  if [[ ! -d "$dir" ]]; then
    # Exact first-line token (tests + client pre-validate assert this).
    # Prefer 'name' form for the stable token; drop quotes when name has ' itself.
    if [[ "$r" == *"'"* ]]; then
      echo "repo-session: no repo ${r} under ${FERRY_REPO_BASE} — pick one below, or run 'ferry <host>' to browse all sessions" >&2
    else
      echo "repo-session: no repo '${r}' under ${FERRY_REPO_BASE} — pick one below, or run 'ferry <host>' to browse all sessions" >&2
    fi

    local -a repos=()
    local line n=0 cap=20 closest
    while IFS= read -r line || [[ -n ${line-} ]]; do
      [[ -z ${line-} ]] && continue
      # Only suggest directory basenames (skip non-dirs from ls).
      [[ -d "${FERRY_REPO_BASE}/${line}" ]] || continue
      repos+=("$line")
    done < <(ls -1 "$FERRY_REPO_BASE" 2>/dev/null || true)

    if ui_tty 2>/dev/null; then
      for line in "${repos[@]+"${repos[@]}"}"; do
        if (( n < cap )); then
          printf '%s  %s%s\n' "${UI_D-}" "$line" "${UI_Z-}" >&2
        fi
        n=$((n + 1))
      done
      if (( n > cap )); then
        printf '%s  …and %d more%s\n' "${UI_D-}" "$((n - cap))" "${UI_Z-}" >&2
      fi
      if closest=$(_ferry_closest_repo "$r" "${repos[@]+"${repos[@]}"}"); then
        printf '%s did you mean %s?%s\n' "${UI_D-}" "$closest" "${UI_Z-}" >&2
      fi
    else
      for line in "${repos[@]+"${repos[@]}"}"; do
        printf '  %s\n' "$line" >&2
      done
    fi
    return 1
  fi
  return 0
}

own_version() {
  local vf="${REPO_ROOT}/VERSION"
  if [[ -r "$vf" ]]; then
    cat "$vf"
  else
    printf 'unknown\n'
  fi
}

# Set when --client-version ≠ remote VERSION (picker header + stderr). Empty = silent.
_FERRY_UPDATE_NUDGE=""

# Build subtle one-liner for picker header / numbered menu.
_set_version_nudge() {
  local client="$1" remote="$2"
  _FERRY_UPDATE_NUDGE=""
  [[ -n "$client" && -n "$remote" && "$client" != "unknown" && "$remote" != "unknown" ]] || return 0
  [[ "$client" == "$remote" ]] && return 0
  # Keep short: fzf header sits in ~40% of terminal width.
  _FERRY_UPDATE_NUDGE="↑ update  client ${client} · remote ${remote}  →  ferry update"
  # Dim/yellow when green-ui is active (TTY); plain text otherwise.
  if ui_tty 2>/dev/null && [[ ${GREEN_UI_MODE-none} != none ]]; then
    _FERRY_UPDATE_NUDGE="${UI_Y-}${UI_D-}${_FERRY_UPDATE_NUDGE}${UI_Z-}"
  fi
}

# Append nudge under hints/banner when present.
_header_with_nudge() {
  local base="$1"
  if [[ -n "${_FERRY_UPDATE_NUDGE:-}" ]]; then
    printf '%s\n%s\n' "$base" "$_FERRY_UPDATE_NUDGE"
  else
    printf '%s\n' "$base"
  fi
}

# Hermes coding-ops registry (same host as tmux). Override with FERRY_CCOPS_STATE.
_ferry_ccops_state() {
  printf '%s\n' "${FERRY_CCOPS_STATE:-$HOME/.hermes/state/ccops}"
}

# Badge from registry for a ccops-* tmux session (status or empty).
_ferry_ccops_badge() {
  local sess="$1" active st
  active="$(_ferry_ccops_state)/active.json"
  [[ -r "$active" ]] || return 0
  st=$(python3 -c "
import json,sys
try:
  d=json.load(open(sys.argv[1]))
  for j in d.get('jobs') or []:
    if j.get('tmux')==sys.argv[2]:
      print(j.get('status') or '')
      break
except Exception:
  pass
" "$active" "$sess" 2>/dev/null || true)
  [[ -n "$st" ]] && printf '%s' "$st"
}

# Wallet label for a live Grok pane (reads GROK_HOME from the pane process / children).
# Prints delieta|muslewski|default|<basename> or empty if not a Grok session / unreadable.
# Linux /proc only; silent no-op on macOS or when no matching process.
_ferry_grok_wallet_badge() {
  local sess="$1" pid tty home base child
  # Match build_session_rows targeting: -t "$sess" (bare name). Exact =$sess can
  # return empty pane_* fields on some tmux builds when only the session is given.
  pid=$("$TMUXBIN" display-message -p -t "$sess" '#{pane_pid}' 2>/dev/null) || return 0
  tty=$("$TMUXBIN" display-message -p -t "$sess" '#{pane_tty}' 2>/dev/null) || true
  [[ -z "$pid" || "$pid" == '#{pane_pid}' ]] && return 0

  _ferry_grok_home_from_pid() {
    local p="$1"
    [[ -r "/proc/$p/environ" ]] || return 1
    tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | sed -n 's/^GROK_HOME=//p' | head -1
  }

  home=$(_ferry_grok_home_from_pid "$pid" || true)
  # Pane may be a shell wrapper; walk children (and tty peers) for grok.real.
  if [[ -z "$home" ]]; then
    for child in $(pgrep -P "$pid" 2>/dev/null); do
      home=$(_ferry_grok_home_from_pid "$child" || true)
      [[ -n "$home" ]] && break
    done
  fi
  if [[ -z "$home" && -n "$tty" && "$tty" != '#{pane_tty}' ]]; then
    for child in $(pgrep -f 'grok\.real' 2>/dev/null); do
      [[ "$(readlink "/proc/$child/fd/0" 2>/dev/null || true)" == "$tty" ]] || continue
      home=$(_ferry_grok_home_from_pid "$child" || true)
      [[ -n "$home" ]] && break
    done
  fi
  [[ -z "${home:-}" ]] && return 0
  base=$(basename "$home")
  case "$home" in
    */.grok-profiles/delieta|*/grok-profiles/delieta) printf 'delieta' ;;
    */.grok-profiles/muslewski|*/grok-profiles/muslewski) printf 'muslewski' ;;
    */.grok) printf 'default' ;;
    *) printf '%s' "$base" ;;
  esac
}

# One line per live session (optionally scoped to <repo>):
#   <session>\t<display_window>\t<N>w\t<attached|detached>\t<cmd>\t<preview_target>
# Display window skips FERRY_HIDDEN_WINDOW_GLOB (default _*); preview_target is session:index.
# Hermes coding-ops sessions (ccops-<repo>-*) are included when filter matches that repo
# or when browsing globally; display window prefixed with hermes:status for ferry visibility.
build_session_rows() {
  local filter="${1:-}" s cname wins att cmd attword
  local active_name active_idx display_name preview_target glob wline widx wname found
  local -a names=()
  local badge _line
  glob="${FERRY_HIDDEN_WINDOW_GLOB:-_*}"
  if [[ -n "$filter" ]]; then
    # Fixed-string match only — never interpolate $filter into grep -E
    # (dots in o'neil-file.txt must not match o'neil-fileXtxt).
    # bash 3.2-safe line read into array (order + blank lines preserved).
    names=()
    while IFS= read -r _line || [[ -n "$_line" ]]; do
      names+=("$_line")
    done < <(_ferry_list_sessions_for_repo "$filter")
  else
    names=()
    while IFS= read -r _line || [[ -n "$_line" ]]; do
      names+=("$_line")
    done < <("$TMUXBIN" list-sessions -F '#{session_name}' 2>/dev/null | sort -V)
  fi
  for s in ${names[@]+"${names[@]}"}; do
    [[ -z "$s" ]] && continue
    # Hide coding-ops monitor side-sessions (ccops-*-mon) — attach the main job session only
    [[ "$s" == *-mon || "$s" == *-mon-* ]] && continue
    active_name=$("$TMUXBIN" display-message -p -t "$s" '#{window_name}')
    active_idx=$("$TMUXBIN" display-message -p -t "$s" '#{window_index}')
    wins=$("$TMUXBIN" display-message -p -t "$s" '#{session_windows}')
    att=$("$TMUXBIN" display-message -p -t "$s" '#{session_attached}')
    cmd=$("$TMUXBIN" display-message -p -t "$s" '#{pane_current_command}')
    if [[ "$att" == "0" ]]; then attword="detached"; else attword="attached"; fi

    display_name="$active_name"
    preview_target="${s}:${active_idx}"
    # If active window is hidden, fall back to first non-matching window by index.
    if [[ "$active_name" == $glob ]]; then
      found=0
      while IFS= read -r wline; do
        [[ -z "$wline" ]] && continue
        widx="${wline%%:*}"
        wname="${wline#*:}"
        if [[ "$wname" != $glob ]]; then
          display_name="$wname"
          preview_target="${s}:${widx}"
          found=1
          break
        fi
      done < <("$TMUXBIN" list-windows -t "$s" -F '#{window_index}:#{window_name}' 2>/dev/null)
      # all-matching → keep active as-is (found stays 0)
      :
    fi

    # Badge Hermes coding sessions so they stand out in ferry picker
    if [[ "$s" == ccops-* ]]; then
      badge="$(_ferry_ccops_badge "$s")"
      if [[ -n "$badge" ]]; then
        display_name="hermes:${badge}:${display_name}"
      else
        display_name="hermes:${display_name}"
      fi
    fi

    # Badge Grok dual-wallet sessions (delieta vs muslewski vs default)
    # so attach never guesses the wrong company identity.
    if [[ "$cmd" == *grok* ]]; then
      badge="$(_ferry_grok_wallet_badge "$s")"
      if [[ -n "$badge" ]]; then
        cmd="grok[$badge]"
        display_name="g:${badge}:${display_name}"
      fi
    fi

    printf '%s\t%s\t%sw\t%s\t%s\t%s\n' "$s" "$display_name" "$wins" "$attword" "$cmd" "$preview_target"
  done
}

picker_kill() {
  # Exact session name (may contain trailing spaces — must match byte-for-byte).
  # Fast path for picker spam — no confirm here.
  # Defense: strip one layer of wrapping quotes. Modern fzf already
  # shell-quotes placeholders; a bind written as n="{1}" becomes n="'name'"
  # and kill would target a non-existent session named 'name' (with quotes).
  local name="$1"
  if (( ${#name} >= 2 )); then
    case "$name" in
      \'*\') name="${name:1:$((${#name} - 2))}" ;;
      \"*\") name="${name:1:$((${#name} - 2))}" ;;
    esac
  fi
  [[ -z "$name" ]] && return 0
  "$TMUXBIN" kill-session -t "=$name" 2>/dev/null || true
}

picker_rename() {
  local old="$1" new="$2"
  # Same name grammar as create_repo / create_home_session — blocks trailing spaces
  # and other names that break fzf field extraction / exact-match targets.
  if [[ -z "$new" || ! "$new" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "repo-session: invalid session name '${new}'" >&2
    return 1
  fi
  "$TMUXBIN" rename-session -t "=$old" "$new"
}

# Rows for fzf (tab-delimited) + synthetic create rows. Used by --picker-rows
# and by fzf --bind reload so kill/rename never tear down the picker.
_NEW_SESSION_LABEL=$'➕ new session…'
_NEW_JUDGE_LABEL=$'⚖ new judge…'
print_picker_rows() {
  local r="${1:-}"
  build_session_rows "$r"
  printf '%s\n' "$_NEW_SESSION_LABEL"
  if _ferry_sage_enabled; then
    printf '%s\n' "$_NEW_JUDGE_LABEL"
  fi
}

# True if the fzf field-1 token is the synthetic "new session" row (not a tmux session).
_is_new_session_row() {
  local n="${1:-}"
  [[ -z "$n" || "$n" == "$_NEW_SESSION_LABEL" || "$n" == "➕ new session…" || "$n" == ➕* ]]
}

_is_new_judge_row() {
  local n="${1:-}"
  [[ "$n" == "$_NEW_JUDGE_LABEL" || "$n" == "⚖ new judge…" || "$n" == ⚖* ]]
}

# Extract a JSON string field value without node/jq (desk nvm shim dies under
# hermetic HOME; picker chrome must not depend on it). First "key":"value" only.
_ferry_json_str_field() {
  local json=${1-} key=${2-}
  [[ -n "$json" && -n "$key" ]] || return 0
  printf '%s' "$json" | awk -F'"' -v key="$key" '
    { for (i = 1; i <= NF; i++) if ($i == key) { print $(i + 2); exit } }
  '
}

# True when top-level JSON boolean "key":true is present (substring-safe for
# the sage about contract; not a full parser).
_ferry_json_bool_true() {
  local json=${1-} key=${2-} s
  s=$(printf '%s' "$json" | tr -d ' \t\n\r\f\v')
  case "$s" in
    *"\"${key}\":true"*) return 0 ;;
    *) return 1 ;;
  esac
}

# fzf preview helper: optional sage chrome + pane capture.
# Args: session_name (field 1) [preview_target field 6]
print_picker_preview() {
  local name="${1:-}" target="${2:-}"
  if _is_new_session_row "$name"; then
    printf '%s\n' '➕ new session — enter to create'
    return 0
  fi
  if _is_new_judge_row "$name"; then
    printf '%s\n' '⚖ new judge — enter → fleet or repo → sage judge run'
    return 0
  fi
  if _ferry_sage_enabled && [[ -n "$name" ]]; then
    local json chrome="" facts judge
    if command -v timeout >/dev/null 2>&1; then
      json=$(timeout 0.25 sage about --tmux "$name" --json 2>/dev/null) || true
    else
      json=$(sage about --tmux "$name" --json 2>/dev/null) || true
    fi
    # awk/boolean parse only — never node (hermetic HOME + desk nvm shim → 127).
    if [[ -n "$json" ]] && _ferry_json_bool_true "$json" found; then
      facts=$(_ferry_json_str_field "$json" facts)
      judge=$(_ferry_json_str_field "$json" judge)
      [[ -n "$facts" ]] && chrome+="$facts"$'\n'
      [[ -n "$judge" ]] && chrome+="⚖ $judge"$'\n'
      chrome=${chrome%$'\n'}
    fi
    if [[ -n "$chrome" ]]; then
      printf '%s\n' "$chrome"
      printf '%s\n' '────────────────'
    fi
  fi
  if [[ -n "$target" ]]; then
    "$TMUXBIN" capture-pane -ep -t "$target" 2>/dev/null || true
  fi
  return 0
}

# Create a new git repo under FERRY_REPO_BASE. No tmux.
# Name must match ^[A-Za-z0-9][A-Za-z0-9._-]*$. Returns 1 on invalid/existing.
create_repo() {
  local name="$1"
  local dir
  if [[ -z "$name" || ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "repo-session: invalid repo name ${name}" >&2
    return 1
  fi
  if ! _ferry_repo_token_ok "$name"; then
    echo "repo-session: invalid repo name ${name}" >&2
    return 1
  fi
  dir="${FERRY_REPO_BASE}/${name}"
  if [[ -e "$dir" ]]; then
    echo "repo-session: already exists: ${dir}" >&2
    return 1
  fi
  mkdir -p "$dir" || return 1
  if ! git -C "$dir" init -q -b main; then
    echo "repo-session: git init failed for ${name}" >&2
    # Self-heal: remove empty non-git orphan so recreate is not blocked.
    if [[ ! -e "$dir/.git" ]]; then
      rmdir "$dir" 2>/dev/null || true
    fi
    return 1
  fi
  return 0
}

# Create (if missing) + attach a session with cwd $HOME. -A semantics.
# Honours startcmd / FERRY_DEFAULT_CMD when creating. Name regex same as create_repo.
create_home_session() {
  local session_name="${1:-home}"
  if [[ -z "$session_name" || ! "$session_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "repo-session: invalid session name '${session_name}'" >&2
    return 1
  fi
  if ! "$TMUXBIN" has-session -t "=$session_name" 2>/dev/null; then
    "$TMUXBIN" new-session -d -s "$session_name" -c "$HOME"
    "$TMUXBIN" send-keys -t "$session_name" "${startcmd:-${FERRY_DEFAULT_CMD:-neofetch}}" C-m
  fi
  exec "$TMUXBIN" attach -t "$session_name"
}

# ---- session helpers ---------------------------------------------------------

_list_repo_sessions() {
  # populate global `sessions` array for $repo (fixed-string; no grep -E)
  # bash 3.2-safe line read into array (order + blank lines preserved).
  local _line
  sessions=()
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    sessions+=("$_line")
  done < <(_ferry_list_sessions_for_repo "$repo")
}

# Numbered list for --list. Window column uses build_session_rows (hidden-window rule).
print_list() {
  local i=1 s cname wins att cmd _preview
  while IFS=$'\t' read -r s cname wins att cmd _preview; do
    [[ -z "$s" ]] && continue
    printf '%d) %-16s %-22s %s\n' "$i" "$s" "$cname" "$wins $att $cmd"
    ((i++)) || true
  done < <(build_session_rows "${repo:-}")
}

# Lock-guarded create of $session in $dir if missing; leaves lock held by caller
# only when caller already holds fd 9. This helper acquires and releases its own.
_create_session_locked() {
  # args: session_name
  local session_name="$1"
  local dir="${FERRY_REPO_BASE}/${repo}"
  local lockf
  lockf=$(_ferry_claim_lockf "$repo")
  _ferry_lock_acquire "$lockf"
  if ! "$TMUXBIN" has-session -t "$session_name" 2>/dev/null; then
    "$TMUXBIN" new-session -d -s "$session_name" -c "$dir"
    "$TMUXBIN" send-keys -t "$session_name" "${startcmd:-$FERRY_DEFAULT_CMD}" C-m
  fi
  _ferry_lock_release
}

_next_free_name() {
  # print next free session name for $repo (primary if free)
  local session="$repo" n=2
  while "$TMUXBIN" has-session -t "$session" 2>/dev/null; do
    session="${repo}-${n}"
    ((n++)) || true
  done
  printf '%s\n' "$session"
}

_attach() {
  # exact match when name known
  exec "$TMUXBIN" attach -t "=$1"
}

_create_and_attach() {
  local session_name="$1"
  _create_session_locked "$session_name"
  exec "$TMUXBIN" attach -t "$session_name"
}

# ---- picker ------------------------------------------------------------------

# Special tokens returned by _pick_repo_for_new (global chain only).
_NEW_REPO_LABEL=$'➕ new repo…'
_HOME_SESSION_LABEL=$'🏠 home session…'
_TOKEN_NEW_REPO='__NEW_REPO__'
_TOKEN_HOME='__HOME__'

_pick_repo_for_new() {
  # Print chosen repo name (or special token) to stdout, or return 1 on cancel.
  # Global chain: repo dirs + new-repo + home-session rows.
  # Repo-scoped: pre-filtered to that repo only — no special rows.
  local -a dirs=()
  local d choice i scoped=0
  if [[ -n "$repo" ]]; then
    dirs=("$repo")
    scoped=1
  else
    if [[ -d "$FERRY_REPO_BASE" ]]; then
      while IFS= read -r d; do
        [[ -n "$d" ]] && dirs+=("$d")
      done < <(ls -1 "$FERRY_REPO_BASE" 2>/dev/null)
    fi
  fi
  if (( scoped == 0 && ${#dirs[@]} == 0 )); then
    # Global with no existing repos: still offer new-repo / home rows.
    :
  elif (( scoped == 1 && ${#dirs[@]} == 0 )); then
    echo "repo-session: no repos under $FERRY_REPO_BASE" >&2
    return 1
  fi

  if command -v fzf >/dev/null 2>&1 && [[ -z "${FERRY_NO_FZF:-}" ]]; then
    local banner sub_hdr=() sub_expect=() header hints pickfile key lc
    banner=$(ferry_banner) || true
    if (( ${#LAUNCHER_KEYS[@]} > 0 )); then
      hints=$(_subpicker_hints)
      if [[ -n "$banner" ]]; then
        header="${banner}"$'\n'"${hints}"
      else
        header="$hints"
      fi
      sub_hdr=(--header "$header")
      sub_expect=(--expect="$(_launcher_expect_suffix | sed 's/^,//')")
    elif [[ -n "$banner" ]]; then
      sub_hdr=(--header "$banner")
    fi
    pickfile="${TMPDIR:-/tmp}/repo-session-subpick.$$"
    if (( scoped )); then
      printf '%s\n' ${dirs[@]+"${dirs[@]}"} | fzf --layout=reverse --header-first --cycle \
        ${sub_hdr[@]+"${sub_hdr[@]}"} ${sub_expect[@]+"${sub_expect[@]}"} --prompt='new session repo> ' \
        >"$pickfile" || { rm -f "$pickfile"; [[ -n "${facefile:-}" ]] && rm -f "$facefile"; return 1; }
    else
      {
        printf '%s\n' ${dirs[@]+"${dirs[@]}"}
        printf '%s\n' "$_NEW_REPO_LABEL"
        printf '%s\n' "$_HOME_SESSION_LABEL"
      } | fzf --layout=reverse --header-first --cycle \
        ${sub_hdr[@]+"${sub_hdr[@]}"} ${sub_expect[@]+"${sub_expect[@]}"} --prompt='new session repo> ' \
        >"$pickfile" || { rm -f "$pickfile"; [[ -n "${facefile:-}" ]] && rm -f "$facefile"; return 1; }
    fi
    if (( ${#LAUNCHER_KEYS[@]} > 0 )); then
      key=$(head -n 1 "$pickfile")
      choice=$(sed -n '2p' "$pickfile")
      if [[ -n "$key" ]] && lc=$(launcher_cmd "$key"); then
        startcmd="$lc"
      fi
    else
      choice=$(cat "$pickfile")
    fi
    rm -f "$pickfile"; [[ -n "${facefile:-}" ]] && rm -f "$facefile"
    if [[ "$choice" == "$_NEW_REPO_LABEL" ]]; then
      printf '%s\n' "$_TOKEN_NEW_REPO"
    elif [[ "$choice" == "$_HOME_SESSION_LABEL" ]]; then
      printf '%s\n' "$_TOKEN_HOME"
    else
      printf '%s\n' "$choice"
    fi
    return 0
  fi

  # numbered menu (no-fzf)
  i=1
  for d in ${dirs[@]+"${dirs[@]}"}; do
    printf '%d) %s\n' "$i" "$d" >&2
    ((i++)) || true
  done
  if (( ! scoped )); then
    printf 'r) new repo\n' >&2
    printf 'h) home session\n' >&2
  fi
  printf 'q) quit\n' >&2
  if ! read -r choice; then
    return 1
  fi
  case "$choice" in
    q|Q|"") return 1 ;;
    r|R)
      if (( ! scoped )); then
        printf '%s\n' "$_TOKEN_NEW_REPO"
        return 0
      fi
      return 1
      ;;
    h|H)
      if (( ! scoped )); then
        printf '%s\n' "$_TOKEN_HOME"
        return 0
      fi
      return 1
      ;;
    *)
      if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#dirs[@]} )); then
        printf '%s\n' "${dirs[$((choice-1))]}"
        return 0
      fi
      return 1
      ;;
  esac
}

# Prompt for new repo name, create_repo, then lock-guarded create+attach.
# Returns 1 on invalid (message already printed) so caller can reload picker.
_flow_new_repo() {
  local name session_name
  printf 'new repo name: ' >/dev/tty
  if ! read -r name </dev/tty; then
    return 1
  fi
  if ! create_repo "$name"; then
    return 1
  fi
  repo="$name"
  session_name=$(_next_free_name)
  _create_and_attach "$session_name"
}

# Prompt for home session name (empty → home), then create_home_session.
# Returns 1 on invalid so caller can reload picker.
_flow_home_session() {
  local name
  printf 'session name [home]: ' >/dev/tty
  if ! read -r name </dev/tty; then
    return 1
  fi
  [[ -z "$name" ]] && name="home"
  create_home_session "$name" || return 1
}

# If startcmd not already armed (hotkey / --claude / -- cmd), offer nested menu.
# default (no AI) is always the first row. Cancel → exit 130.
_arm_start_cmd_if_needed() {
  local picked
  [[ -n "${startcmd:-}" ]] && return 0
  if (( ${#START_MENU_CMDS[@]} > 0 || ${#LAUNCHER_CMDS[@]} > 0 )); then
    picked=$(_pick_start_cmd) || exit 130
    startcmd="$picked"
  fi
  return 0
}

# Sage judge create: scope fleet | repo → tmux session running sage judge run.
# Returns 1 on invalid/cancel-reload; exits 130 on hard cancel; execs on success.
_do_new_judge_flow() {
  local scope choice name dir="" i d
  if ! _ferry_sage_enabled; then
    echo "repo-session: sage not available (install agentic-sage or set FERRY_SAGE=auto)" >&2
    return 1
  fi
  # Scope menu
  if command -v fzf >/dev/null 2>&1 && [[ -z "${FERRY_NO_FZF:-}" ]]; then
    choice=$(
      printf '%s\n' 'fleet (desk-wide)' 'repo…' | fzf --layout=reverse --header-first --cycle \
        --header 'judge scope · enter=pick · esc=cancel' --prompt='judge> '
    ) || exit 130
  else
    printf '1) fleet (desk-wide)\n2) repo…\nq) cancel\n' >&2
    if ! read -r choice; then exit 130; fi
    case "$choice" in
      q|Q|"") exit 130 ;;
      1) choice='fleet (desk-wide)' ;;
      2) choice='repo…' ;;
      *) return 1 ;;
    esac
  fi
  [[ -z "$choice" ]] && exit 130
  if [[ "$choice" == fleet* ]]; then
    scope=fleet
    name="sage-judge"
    dir="$HOME"
    startcmd="sage judge run --fleet"
  else
    scope=repo
    # Pick repo under base (no home/new-repo rows)
    local -a dirs=()
    if [[ -n "${repo:-}" ]]; then
      dirs=("$repo")
    elif [[ -d "$FERRY_REPO_BASE" ]]; then
      while IFS= read -r d; do
        [[ -n "$d" ]] && dirs+=("$d")
      done < <(ls -1 "$FERRY_REPO_BASE" 2>/dev/null)
    fi
    if (( ${#dirs[@]} == 0 )); then
      echo "repo-session: no repos under $FERRY_REPO_BASE for judge --repo" >&2
      return 1
    fi
    if command -v fzf >/dev/null 2>&1 && [[ -z "${FERRY_NO_FZF:-}" ]]; then
      choice=$(printf '%s\n' ${dirs[@]+"${dirs[@]}"} | fzf --layout=reverse --header-first --cycle \
        --header 'judge repo · enter=pick · esc=cancel' --prompt='judge repo> ') || exit 130
    else
      i=1
      for d in ${dirs[@]+"${dirs[@]}"}; do
        printf '%d) %s\n' "$i" "$d" >&2
        ((i++)) || true
      done
      printf 'q) cancel\n' >&2
      if ! read -r choice; then exit 130; fi
      case "$choice" in
        q|Q|"") exit 130 ;;
        *)
          if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#dirs[@]} )); then
            choice="${dirs[$((choice - 1))]}"
          else
            return 1
          fi
          ;;
      esac
    fi
    [[ -z "$choice" ]] && exit 130
    if [[ ! -d "${FERRY_REPO_BASE}/${choice}" ]]; then
      echo "repo-session: no repo '${choice}' under $FERRY_REPO_BASE" >&2
      return 1
    fi
    name="sage-judge-${choice}"
    # Sanitize session name
    name="${name// /-}"
    dir="${FERRY_REPO_BASE}/${choice}"
    startcmd="sage judge run --repo"
  fi
  # Create detached session if missing, then attach
  if ! "$TMUXBIN" has-session -t "=$name" 2>/dev/null; then
    "$TMUXBIN" new-session -d -s "$name" -c "$dir"
    "$TMUXBIN" send-keys -t "$name" "$startcmd" C-m
  fi
  exec "$TMUXBIN" attach -t "=$name"
}

# Returns 1 on invalid input (reload picker); exits 130 on cancel; execs on success.
_do_new_session_flow() {
  local chosen name
  # Destination first, then start-command menu (unless already armed).
  chosen=$(_pick_repo_for_new) || exit 130
  [[ -z "$chosen" ]] && exit 130
  _arm_start_cmd_if_needed

  case "$chosen" in
    "$_TOKEN_NEW_REPO")
      _flow_new_repo || return 1
      return 0
      ;;
    "$_TOKEN_HOME")
      _flow_home_session || return 1
      return 0
      ;;
  esac

  if [[ ! -d "${FERRY_REPO_BASE}/${chosen}" ]]; then
    echo "repo-session: no repo '${chosen}' under $FERRY_REPO_BASE" >&2
    return 1
  fi
  repo="$chosen"
  name=$(_next_free_name)
  _create_and_attach "$name"
}



# ctrl-f action: print fix plan; execute recipe only when FERRY_SERVERS_FIX=on.
_picker_servers_fix() {
  local port="${1:-}"
  [[ -n "$port" ]] || return 0
  local row state id class label bind pid comm repo owner mac_state mac_url health restart
  local plan action detail cwd
  row="$(print_servers_rows | awk -F'\t' -v p="$port" '$1==p{print; exit}')"
  [[ -n "$row" ]] || { printf 'no row for port %s\n' "$port" >/dev/tty; return 0; }
  IFS=$'\t' read -r port state id class label bind pid comm repo owner mac_state mac_url health restart <<<"$row"
  cwd="-"
  if [[ -n "$pid" && "$pid" != "-" && -r "/proc/$pid/cwd" ]]; then
    cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null || echo -)"
  elif [[ -n "$repo" && "$repo" != "-" ]]; then
    cwd="${FERRY_REPO_BASE:-$HOME/Repositories}/${repo}"
  fi
  # declared-missing uses declare action
  if [[ "$state" == "declared-missing" ]]; then
    plan="$(servers_fix_plan "declared-missing" "$class" "$port" "$cwd")"
  else
    plan="$(servers_fix_plan "$mac_state" "$class" "$port" "$cwd")"
  fi
  action="${plan%%$'\t'*}"
  detail="${plan#*$'\t'}"
  printf 'fix plan for :%s (%s / %s)\\n  action: %s\\n  %s\\n' "$port" "$mac_state" "$class" "$action" "$detail" >/dev/tty
  if [[ "$action" == "recipe" && "${FERRY_SERVERS_FIX:-off}" == "on" ]]; then
    printf 'FERRY_SERVERS_FIX=on — would run: %s\\n' "$detail" >/dev/tty
    # Intentionally do not auto-exec here without an explicit second confirm in v1.
    # Discovery remains observer-first.
  elif [[ "$action" == "recipe" ]]; then
    printf '(FERRY_SERVERS_FIX is off — recipe printed only, not executed)\\n' >/dev/tty
  fi
}

# ---- servers face helpers ----------------------------------------------------

# Formatted rows for the servers face / --servers one-shot (TSV, 14 cols).
print_servers_rows() {
  build_server_rows 2>/dev/null || true
}

# Human-ish one line for fzf list: port · state · label · mac_state · class
print_servers_picker_rows() {
  # field1=port (preview/fix key); field2=human summary. Full row re-fetched by port.
  local port state id class label bind pid comm repo owner mac_state mac_url health restart
  while IFS=$'\t' read -r port state id class label bind pid comm repo owner mac_state mac_url health restart; do
    [[ -z "${port:-}" ]] && continue
    printf '%s\t%s  %s  %s  [%s]  %s\n' \
      "$port" "$state" "$label" "$mac_state" "$class" "$bind"
  done < <(print_servers_rows)
}

# Preview pane for a server port (field 1).
print_servers_preview() {
  local port="${1:-}"
  [[ -z "$port" || "$port" == "-" ]] && { printf '%s\n' 'no port selected'; return 0; }
  local row port_r state id class label bind pid comm repo owner mac_state mac_url health restart
  row="$(print_servers_rows | awk -F'\t' -v p="$port" '$1==p{print; exit}')"
  if [[ -z "$row" ]]; then
    printf 'port %s — not in current discovery\n' "$port"
    return 0
  fi
  IFS=$'\t' read -r port_r state id class label bind pid comm repo owner mac_state mac_url health restart <<<"$row"
  printf 'port:      %s\n' "$port_r"
  printf 'state:     %s\n' "$state"
  printf 'id:        %s\n' "$id"
  printf 'class:     %s\n' "$class"
  printf 'label:     %s\n' "$label"
  printf 'bind:      %s\n' "$bind"
  printf 'pid/comm:  %s / %s\n' "$pid" "$comm"
  printf 'repo:      %s\n' "$repo"
  printf 'owner:     %s\n' "$owner"
  printf 'mac_state: %s\n' "$mac_state"
  printf 'mac_url:   %s\n' "$mac_url"
  printf 'health:    %s\n' "$health"
  printf 'restart:   %s\n' "$restart"
  if [[ "$state" == "FOREIGN" ]]; then
    printf '\n⚠ FOREIGN — listener cwd does not match declared repo\n'
  fi
  if [[ "$port_r" == "8791" ]]; then
    printf '\n⛔ RESERVED — FreeLLMAPI permanent listener. Never use for previews.\n'
  fi
  # Health check with short timeout when declared
  if [[ -n "$health" && "$health" != "-" && "$health" == http* ]]; then
    printf '\n── health ──\n'
    if command -v timeout >/dev/null 2>&1; then
      timeout 0.4 curl -fsS -m 0.4 "$health" 2>&1 | head -c 400 || printf '(health check failed or timed out)\n'
      printf '\n'
    else
      curl -fsS -m 1 "$health" 2>&1 | head -c 400 || printf '(health check failed)\n'
      printf '\n'
    fi
  fi
  # Mapped log: <repo>/.ferry/server.log or declaration log path not yet standardized —
  # show last lines of common log when repo is known.
  if [[ -n "$repo" && "$repo" != "-" ]]; then
    local base="${FERRY_REPO_BASE:-$HOME/Repositories}"
    local logf="${base}/${repo}/.ferry/server.log"
    if [[ -r "$logf" ]]; then
      printf '\n── log (tail) ──\n'
      tail -n 15 "$logf" 2>/dev/null || true
    fi
  fi
  # Fix plan hint
  if declare -F servers_fix_plan >/dev/null 2>&1; then
    local plan action detail
    plan="$(servers_fix_plan "$mac_state" "$class" "$port_r" "${repo:--}" 2>/dev/null || true)"
    action="${plan%%$'\t'*}"
    detail="${plan#*$'\t'}"
    printf '\n── fix (ctrl-f) ──\n%s: %s\n' "$action" "$detail"
  fi
}

# Escape a string for JSON (hand-rolled; jq absent).
_servers_json_escape() {
  local s="${1-}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# Emit JSON array of row objects to stdout. Never requires a tty.
print_servers_json() {
  local port state id class label bind pid comm repo owner mac_state mac_url health restart
  local first=1
  printf '['
  while IFS=$'\t' read -r port state id class label bind pid comm repo owner mac_state mac_url health restart; do
    [[ -z "${port:-}" ]] && continue
    if (( first )); then first=0; else printf ','; fi
    printf '\n{"port":"%s","state":"%s","id":"%s","class":"%s","label":"%s","bind":"%s","pid":"%s","comm":"%s","repo":"%s","owner":"%s","mac_state":"%s","mac_url":"%s","health":"%s","restart":"%s"}' \
      "$(_servers_json_escape "$port")" \
      "$(_servers_json_escape "$state")" \
      "$(_servers_json_escape "$id")" \
      "$(_servers_json_escape "$class")" \
      "$(_servers_json_escape "$label")" \
      "$(_servers_json_escape "$bind")" \
      "$(_servers_json_escape "$pid")" \
      "$(_servers_json_escape "$comm")" \
      "$(_servers_json_escape "$repo")" \
      "$(_servers_json_escape "$owner")" \
      "$(_servers_json_escape "$mac_state")" \
      "$(_servers_json_escape "$mac_url")" \
      "$(_servers_json_escape "$health")" \
      "$(_servers_json_escape "$restart")"
  done < <(print_servers_rows)
  printf '\n]\n'
}

# OSC52 copy helper (best-effort; no-op if not a tty).
_servers_osc52_copy() {
  local text="$1"
  local b64
  if command -v base64 >/dev/null 2>&1; then
    b64="$(printf '%s' "$text" | base64 -w0 2>/dev/null || printf '%s' "$text" | base64 | tr -d '\n')"
  else
    return 1
  fi
  # Write to /dev/tty when available so fzf execute can surface it
  if [[ -w /dev/tty ]]; then
    printf '\033]52;c;%s\a' "$b64" >/dev/tty 2>/dev/null || true
  else
    printf '\033]52;c;%s\a' "$b64"
  fi
}

run_picker() {
  # Uses global $repo (may be empty = global).
  local -a rows=()
  local line choice name i nsel key ans newname pickfile
  local new_label=$'➕ new session…'
  local is_new=0

  # Numbered menu fallback: loop so invalid create-flow input reloads.
  if ! command -v fzf >/dev/null 2>&1 || [[ -n "${FERRY_NO_FZF:-}" ]]; then
    while true; do
      rows=()
      while IFS= read -r line; do
        [[ -n "$line" ]] && rows+=("$line")
      done < <(build_session_rows "$repo")
      ferry_banner
      if [[ -n "${_FERRY_UPDATE_NUDGE:-}" ]]; then
        printf '%s\n' "$_FERRY_UPDATE_NUDGE"
      fi
      i=1
      for line in ${rows[@]+"${rows[@]}"}; do
        name="${line%%$'\t'*}"
        printf '%d) %s\n' "$i" "$line" | tr '\t' ' '
        ((i++)) || true
      done
      printf 'n) new session…\n'
      printf 'q) quit\n'
      if ! read -r nsel; then
        exit 130
      fi
      case "$nsel" in
        q|Q|"") exit 130 ;;
        n|N)
          # On invalid name: message already printed; reload this menu.
          _do_new_session_flow || continue
          ;;
        *)
          if [[ "$nsel" =~ ^[0-9]+$ ]] && (( nsel >= 1 && nsel <= ${#rows[@]} )); then
            line="${rows[$((nsel-1))]}"
            name="${line%%$'\t'*}"
            exec "$TMUXBIN" attach -t "=$name"
          fi
          echo "repo-session: invalid selection" >&2
          continue
          ;;
      esac
    done
    return
  fi

  # fzf path: kill/rename stay *inside* one fzf instance (bind+reload).
  # Optimistic kill: one keystroke, no confirm, no picker teardown — spam-friendly.
  # Optional FERRY_KILL_CONFIRM=1 restores single-key y/N confirm.
  # Servers face (ctrl-s): second view; face state in a temp file for reload.
  pickfile="${TMPDIR:-/tmp}/repo-session-pick.$$"
  local facefile="${TMPDIR:-/tmp}/repo-session-face.$$"
  printf 'sessions\n' >"$facefile"
  local banner hints header expect_keys lc self self_q rows_cmd bind_kill bind_rename
  local bind_face bind_fix rows_cmd_sessions rows_cmd_servers
  local header_sessions header_servers
  local launcher_expect fzf_status face
  new_label="$_NEW_SESSION_LABEL"
  self=$(_ferry_resolve_self) || self="${BASH_SOURCE[0]}"
  self_q=$(printf '%q' "$self")
  facefile_q=$(printf '%q' "$facefile")
  if [[ -n "$repo" ]]; then
    rows_cmd_sessions="bash ${self_q} --picker-rows $(printf '%q' "$repo")"
  else
    rows_cmd_sessions="bash ${self_q} --picker-rows"
  fi
  rows_cmd_servers="bash ${self_q} --picker-servers-rows"
  # Unified rows_cmd reads facefile
  rows_cmd="bash ${self_q} --picker-face-rows ${facefile_q}"
  if [[ -n "$repo" ]]; then
    rows_cmd="bash ${self_q} --picker-face-rows ${facefile_q} $(printf '%q' "$repo")"
  fi
  if (( ${#START_MENU_CMDS[@]} > 0 || ${#LAUNCHER_KEYS[@]} > 0 )); then
    hints='[sessions] enter=attach · ➕=start menu · ctrl-x=kill · ctrl-r=rename · ctrl-s=servers · esc=quit'
  else
    hints='[sessions] enter=attach · ctrl-x=kill · ctrl-r=rename · ctrl-s=servers · esc=quit'
  fi
  header_servers='[servers] enter=copy Mac URL · ctrl-f=fix plan · ctrl-s=sessions · esc=quit'
  header_sessions="$hints"
  # Kill: execute-silent then reload list in place (no exit, no y/Enter).
  #
  # fzf placeholder rules (0.36+; verified on 0.72):
  #   {1}  → already shell-quoted field 1  (do NOT wrap as "{1}" — that yields
  #          n="'name'" and kill targets a session literally named 'name')
  #   {1}  also strips trailing field whitespace, so trailing-space session
  #          names must come from the full line {} + bash tab-split.
  # Skip synthetic ➕/⚖ rows. Optional confirm via FERRY_KILL_CONFIRM.
  bind_kill="ctrl-x:execute-silent(
    face=\$(cat ${facefile_q} 2>/dev/null || echo sessions)
    [ \"\$face\" = servers ] && exit 0
    line={}
    n=\"\${line%%\$'\\t'*}\"
    case \"\$n\" in ''|➕*|⚖*) exit 0 ;; esac
    if [ \"\${FERRY_KILL_CONFIRM:-0}\" = 1 ]; then
      printf 'kill %s? [y/N] ' \"\$n\" >/dev/tty
      read -rsn1 a </dev/tty || exit 0
      printf '\\n' >/dev/tty
      case \"\$a\" in y|Y) ;; *) exit 0 ;; esac
    fi
    bash ${self_q} --picker-kill \"\$n\"
  )+reload(${rows_cmd})"
  # Rename: still needs a name; stays in-picker via execute+reload.
  # Same full-line extract as kill (fzf {1} would drop trailing spaces / double-quote).
  bind_rename="ctrl-r:execute(
    face=\$(cat ${facefile_q} 2>/dev/null || echo sessions)
    [ \"\$face\" = servers ] && exit 0
    line={}
    n=\"\${line%%\$'\\t'*}\"
    case \"\$n\" in ''|➕*|⚖*) exit 0 ;; esac
    printf 'new name: ' >/dev/tty
    read -r nn </dev/tty || exit 0
    [ -n \"\$nn\" ] || exit 0
    bash ${self_q} --picker-rename \"\$n\" \"\$nn\"
  )+reload(${rows_cmd})"

  # Face toggle: flip facefile, reload rows, transform header. fzf stays up.
  bind_face="ctrl-s:execute-silent(
    f=\$(cat ${facefile_q} 2>/dev/null || echo sessions)
    if [ \"\$f\" = servers ]; then echo sessions; else echo servers; fi > ${facefile_q}
  )+reload(${rows_cmd})+transform-header(bash ${self_q} --picker-face-header ${facefile_q})"
  # Fix plan (servers face): print plan to tty; execute recipe only if FERRY_SERVERS_FIX=on
  bind_fix="ctrl-f:execute(
    face=\$(cat ${facefile_q} 2>/dev/null || echo sessions)
    [ \"\$face\" = servers ] || exit 0
    line={}
    port=\"\${line%%\$'\\t'*}\"
    [ -n \"\$port\" ] || exit 0
    bash ${self_q} --picker-servers-fix \"\$port\"
    printf '\\n[press enter]\\n' >/dev/tty
    read -r _ </dev/tty || true
  )"

  # Launchers still use --expect (they must exit fzf to arm create / attach).
  launcher_expect="$(_launcher_expect_suffix | sed 's/^,//')"
  expect_keys="$launcher_expect"

  while true; do
    # Header lives left of right:60% preview → banner width is 40% of cols.
    local cols banner_w
    cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
    banner_w=$(( cols * 40 / 100 ))
    banner=$(ferry_banner "$banner_w") || true
    if [[ -n "$banner" ]]; then
      header="${banner}"$'\n'"${hints}"
    else
      header="$hints"
    fi
    # Subtle update line when client/remote VERSION diverge (set in main handshake).
    header="$(_header_with_nudge "$header")"

    # Preview: sage chrome (optional) + pane capture via --picker-preview.
    # Empty field 6 on synthetic rows is handled inside print_picker_preview
    # (never bare capture-pane -t '' → self-mirror / duplicates).
    # Header reflects current face
    face="$(cat "$facefile" 2>/dev/null || echo sessions)"
    if [[ "$face" == "servers" ]]; then
      header="$header_servers"
      header="$(_header_with_nudge "$header")"
    fi
    local -a fzf_args=(
      --ansi --delimiter=$'\t'
      --layout=reverse --header-first --cycle
      --header "$header"
      --preview "bash ${self_q} --picker-face-preview ${facefile_q} {1} {6}"
      --preview-window=right:60%
      --bind "$bind_kill"
      --bind "$bind_rename"
      --bind "$bind_face"
      --bind "$bind_fix"
    )
    if [[ -n "$expect_keys" ]]; then
      fzf_args+=(--expect="$expect_keys")
    fi
    if [[ "$face" == "servers" ]]; then
      print_servers_picker_rows | fzf ${fzf_args[@]+"${fzf_args[@]}"} >"$pickfile"
    else
      print_picker_rows "$repo" | fzf ${fzf_args[@]+"${fzf_args[@]}"} >"$pickfile"
    fi
    fzf_status=$?
    if (( fzf_status != 0 )); then
      rm -f "$pickfile"; [[ -n "${facefile:-}" ]] && rm -f "$facefile"
      exit 130
    fi

    if [[ -n "$expect_keys" ]]; then
      key=$(head -n 1 "$pickfile")
      choice=$(sed -n '2p' "$pickfile")
    else
      key=""
      choice=$(head -n 1 "$pickfile")
    fi
    rm -f "$pickfile"
    # Keep facefile for the rest of this iteration (servers enter / continue).

    # Servers face: enter copies Mac URL (OSC52) when reachable; never opens.
    face="$(cat "$facefile" 2>/dev/null || echo sessions)"
    if [[ "$face" == "servers" ]]; then
      local sport smac smurl srow
      sport="${choice%%$'\t'*}"
      if [[ -n "$sport" ]]; then
        srow="$(print_servers_rows | awk -F'\t' -v p="$sport" '$1==p{print; exit}')"
        smac="$(printf '%s\n' "$srow" | cut -f11)"
        smurl="$(printf '%s\n' "$srow" | cut -f12)"
        if [[ "$smac" == "reachable" && -n "$smurl" && "$smurl" != "-" ]]; then
          _servers_osc52_copy "$smurl" || true
          printf 'copied: %s\n' "$smurl" >/dev/tty 2>/dev/null || printf 'copied: %s\n' "$smurl" >&2
        else
          printf 'no Mac URL (mac_state=%s)\n' "${smac:-unknown}" >/dev/tty 2>/dev/null ||             printf 'no Mac URL (mac_state=%s)\n' "${smac:-unknown}" >&2
        fi
      fi
      continue
    fi

    is_new=0
    if [[ "$choice" == "$new_label" || "$choice" == *$'\t'"$new_label" || "$choice" == "➕ new session…" ]]; then
      is_new=1
    fi
    name="${choice%%$'\t'*}"

    # ⚖ new judge (sage wire only)
    if _is_new_judge_row "$name" || [[ "$choice" == "$_NEW_JUDGE_LABEL" ]]; then
      _do_new_judge_flow || continue
      continue
    fi

    # Launcher keys on the new-session row arm create; kill/rename are binds (no expect).
    if (( is_new )); then
      if [[ -n "$key" ]] && lc=$(launcher_cmd "$key"); then
        startcmd="$lc"
      fi
      # Success execs attach; cancel exits 130; invalid returns → reload.
      _do_new_session_flow || continue
      continue
    fi

    [[ -z "$name" ]] && exit 130

    # Launcher keys on existing-session rows: ignore, reload.
    if [[ -n "$key" ]] && launcher_cmd "$key" >/dev/null 2>&1; then
      continue
    fi
    # Enter (or empty expect key) → attach
    exec "$TMUXBIN" attach -t "=$name"
  done
}

# ---- main --------------------------------------------------------------------

main() {
  local repo="" fresh=0 list=0 pick="" startcmd="" claim=0 fill=0 wantpick=0 help=0 primary=0
  local client_version="" validate=0 validate_arg=""
  local picker_rows=0 picker_kill_name="" picker_rename_old="" picker_rename_new=""
  local picker_preview=0 picker_preview_name="" picker_preview_target=""
  local servers_list=0 servers_json=0
  local picker_servers_rows=0 picker_servers_preview=0 picker_servers_preview_port=""
  local picker_servers_fix=0 picker_servers_fix_port=""
  local picker_face_rows=0 picker_face_preview=0 picker_face_header=0
  local picker_face_file="" picker_face_arg2="" picker_face_arg3=""
  local dir sessions
  sessions=()

  while (( $# )); do
    case "$1" in
      --new)              fresh=1; shift ;;
      --list|-l)          list=1; shift ;;
      --resume|-R)        wantpick=1
                          if [[ -n "${2:-}" && "${2:-}" != -* ]]; then pick="$2"; shift 2; else shift; fi ;;
      --resume-closed)    claim=1; shift ;;
      --resume-or-new)    claim=1; fill=1; shift ;;
      --claude|-c)        startcmd="claude"; shift ;;
      --help|-h)          help=1; shift ;;
      --primary|-p)       primary=1; shift ;;
      --client-version)   client_version="${2:-}"; shift 2 ;;
      --validate)
        # Allow leading-dash basenames via: --validate -- -foo
        if [[ "${2:-}" == "--" && -n "${3:-}" ]]; then
          validate=1
          validate_arg="$3"
          shift 3
        elif [[ -z "${2:-}" ]]; then
          echo "repo-session: --validate requires a <repo>" >&2
          exit 1
        elif [[ "${2:-}" == -* ]]; then
          # Bare leading-dash without -- separator: accept as name (not a flag).
          validate=1
          validate_arg="$2"
          shift 2
        else
          validate=1
          validate_arg="$2"
          shift 2
        fi
        ;;
      # Internal: fzf --bind reload / execute (not user-facing).
      --picker-rows)
        picker_rows=1
        if [[ -n "${2:-}" && "${2:-}" != -* ]]; then repo="$2"; shift 2; else shift; fi
        ;;
      --picker-preview)
        # fzf --preview: session name + optional pane target
        picker_preview=1
        picker_preview_name="${2:-}"
        picker_preview_target="${3:-}"
        shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        ;;
      --picker-kill)
        if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
          echo "repo-session: --picker-kill requires a <session>" >&2
          exit 1
        fi
        picker_kill_name="$2"
        shift 2
        ;;
      --picker-rename)
        if [[ -z "${2:-}" || "${2:-}" == -* || -z "${3:-}" || "${3:-}" == -* ]]; then
          echo "repo-session: --picker-rename requires <old> <new>" >&2
          exit 1
        fi
        picker_rename_old="$2"
        picker_rename_new="$3"
        shift 3
        ;;
      --servers)
        servers_list=1
        shift
        while (( $# )) && [[ "${1:-}" == --json ]]; do
          servers_json=1
          shift
        done
        # also allow --servers --json as separate tokens already handled; if next is --json:
        ;;
      --json)
        # Allow `repo-session --servers --json` after --servers set the flag,
        # or standalone after --servers in same argv (handled below).
        if (( servers_list )); then
          servers_json=1
          shift
        else
          echo "repo-session: --json requires --servers" >&2
          exit 1
        fi
        ;;
      --picker-servers-rows)
        picker_servers_rows=1
        shift
        ;;
      --picker-servers-preview)
        picker_servers_preview=1
        picker_servers_preview_port="${2:-}"
        shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        ;;
      --picker-servers-fix)
        picker_servers_fix=1
        picker_servers_fix_port="${2:-}"
        shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        ;;
      --picker-face-rows)
        picker_face_rows=1
        picker_face_file="${2:-}"
        shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        if [[ -n "${1:-}" && "${1:-}" != -* ]]; then
          repo="$1"
          shift
        fi
        ;;
      --picker-face-preview)
        picker_face_preview=1
        picker_face_file="${2:-}"
        picker_face_arg2="${3:-}"
        picker_face_arg3="${4:-}"
        shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        ;;
      --picker-face-header)
        picker_face_header=1
        picker_face_file="${2:-}"
        shift
        [[ $# -gt 0 && "${1:-}" != -* ]] && shift
        ;;
      --)                 shift; startcmd="$*"; break ;;
      -*)                 echo "repo-session: ignoring unknown flag '$1'" >&2; shift ;;
      *)                  if [[ -z "$repo" ]]; then repo="$1"; else startcmd="${startcmd:+$startcmd }$1"; fi; shift ;;
    esac
  done

  load_config
  parse_launchers
  parse_start_menu

  # --validate dispatches first (before help/list/resume); never touches tmux.
  if (( validate )); then
    validate_repo "$validate_arg"
    exit $?
  fi

  # Verbs that must not require tmux (macOS may lack it entirely).
  # --help is handled later (after optional version handshake); skip preflight for it.
  # The servers face and the face header never call tmux: print_servers_picker_rows
  # (:1397), print_servers_preview (:1408) and _picker_servers_fix (:1357) contain no
  # TMUXBIN reference — the nearest ones are _do_new_judge_flow (:1319) and run_picker
  # (:1562). --picker-face-header is a bare printf.
  # Verified on real macOS (bash 3.2, no tmux): without these exemptions
  # `--picker-face-header` died on the preflight and test-servers lost the two
  # header assertions.
  # The face-dependent verbs (--picker-face-rows / --picker-face-preview) require
  # tmux only on their sessions branch; each calls _require_tmux there.
  # Everything else (list, picker, attach, claim, session fzf helpers) needs tmux.
  if (( ! help && ! servers_list && ! picker_servers_rows && ! picker_servers_preview \
        && ! picker_servers_fix && ! picker_face_header && ! picker_face_rows \
        && ! picker_face_preview )); then
    _require_tmux
  fi

  # Internal picker helpers (fzf bind+reload) — exit immediately.
  if (( picker_rows )); then
    print_picker_rows "$repo"
    exit 0
  fi
  if (( picker_preview )); then
    print_picker_preview "$picker_preview_name" "$picker_preview_target"
    exit 0
  fi
  if [[ -n "$picker_kill_name" ]]; then
    picker_kill "$picker_kill_name"
    exit 0
  fi
  if [[ -n "$picker_rename_old" ]]; then
    picker_rename "$picker_rename_old" "$picker_rename_new"
    exit $?
  fi
  if (( picker_servers_rows )); then
    print_servers_picker_rows
    exit 0
  fi
  if (( picker_servers_preview )); then
    print_servers_preview "$picker_servers_preview_port"
    exit 0
  fi
  if (( picker_servers_fix )); then
    _picker_servers_fix "$picker_servers_fix_port"
    exit 0
  fi
  if (( picker_face_rows )); then
    face="$(cat "$picker_face_file" 2>/dev/null || echo sessions)"
    if [[ "$face" == "servers" ]]; then
      print_servers_picker_rows
    else
      _require_tmux
      print_picker_rows "$repo"
    fi
    exit 0
  fi
  if (( picker_face_preview )); then
    face="$(cat "$picker_face_file" 2>/dev/null || echo sessions)"
    if [[ "$face" == "servers" ]]; then
      print_servers_preview "$picker_face_arg2"
    else
      _require_tmux
      print_picker_preview "$picker_face_arg2" "$picker_face_arg3"
    fi
    exit 0
  fi
  if (( picker_face_header )); then
    face="$(cat "$picker_face_file" 2>/dev/null || echo sessions)"
    if [[ "$face" == "servers" ]]; then
      printf '%s\n' '[servers] enter=copy Mac URL · ctrl-f=fix plan · ctrl-s=sessions · esc=quit'
    else
      printf '%s\n' '[sessions] enter=attach · ctrl-x=kill · ctrl-r=rename · ctrl-s=servers · esc=quit'
    fi
    exit 0
  fi
  # --servers one-shot (non-interactive; agents use this)
  if (( servers_list )); then
    if (( servers_json )); then
      print_servers_json
    else
      print_servers_rows
    fi
    exit 0
  fi

  # Version handshake (warn only; never block). Surfaces in picker header too.
  if [[ -n "$client_version" ]]; then
    local ov
    ov="$(own_version | tr -d '[:space:]')"
    if [[ -n "$ov" && "$client_version" != "$ov" ]]; then
      echo "mossferry: client ${client_version} / remote ${ov} — run 'ferry update'" >&2
      _set_version_nudge "$client_version" "$ov"
    fi
  fi

  if (( help )); then
    local ver S="" Z=""
    ver="$(own_version | tr -d '[:space:]')"
    ferry_banner
    if ui_tty 2>/dev/null && [[ ${GREEN_UI_MODE-none} != none ]]; then
      S="${UI_G-}${UI_BOLD-}"
      Z="${UI_Z-}"
    fi
    cat <<EOF
${S}Usage${Z}
  repo-session [repo] [flags]   host brain for mossferry (picker, attach, list)

  Runs on the machine that owns the repos and tmux. The laptop client (ferry)
  invokes this for you; call it directly only when debugging on the host.

${S}Primary commands${Z}
  repo-session                      global session picker
  repo-session <repo>               picker scoped to that repo
  repo-session <repo> -p            attach/create primary session
  repo-session --list               list sessions (with <repo>: scoped)
  repo-session --servers            listeners (14-col TSV); add --json
  repo-session --validate <repo>    exit 0 if dir under FERRY_REPO_BASE (no tmux)
  repo-session --help               this help

${S}Happy path${Z}
  repo-session --validate my-app    # shape + directory under FERRY_REPO_BASE
  repo-session my-app -p            # attach/create primary tmux session
  repo-session --list               # numbered list, then exit
  # Create works headless; attach needs a TTY (else: open terminal failed: not a terminal).

${S}Picker${Z}
  enter=attach · ➕ new → nested start menu · ctrl-x=kill · ctrl-r=rename
  ctrl-s=servers face · esc=quit · list wraps (fzf --cycle)
  Servers face: enter=copy Mac URL · ctrl-f=fix plan · ctrl-s=sessions
  Kill stays in the picker (spam ctrl-x). FERRY_KILL_CONFIRM=1 → single-key y/N.
  Start menu: FERRY_START_MENU (default claude,grok). FERRY_LAUNCHERS optional
  (reserved: ctrl-x, ctrl-r, ctrl-s, ctrl-f).

${S}Flags${Z}
  --primary, -p      attach primary, create if missing (needs <repo>)
  --new              fresh session (repo, repo-2, …) (needs <repo>)
  --claude, -c       new sessions start \`claude\` (default: neofetch)
  --list, -l         list sessions and exit
  --resume [N|name]  bare → picker; N → Nth; name → exact attach
  --resume-closed    claim one EXISTING session (atomic; prefers detached)
  --resume-or-new    claim or create until the grid fills
  --client-version V version handshake (set by ferry client; warn only)
  --validate <repo>  check repo under FERRY_REPO_BASE (no tmux)
  --servers          live listeners TSV; --json for agents
  -- cmd...          custom start command for newly created sessions

${S}Full reference${Z}
  docs/command-reference.md · docs/configuration.md · config.example

mossferry ${ver} · the green ferry between your machines
EOF
    exit 0
  fi

  # --resume with N or name (bare --resume falls through to picker later)
  if (( wantpick )) && [[ -n "$pick" ]]; then
    if [[ "$pick" =~ ^[0-9]+$ ]]; then
      # bash 3.2-safe line read into array (order + blank lines preserved).
      local _line
      sessions=()
      if [[ -n "$repo" ]]; then
        while IFS= read -r _line || [[ -n "$_line" ]]; do
          sessions+=("$_line")
        done < <(_ferry_list_sessions_for_repo "$repo")
      else
        while IFS= read -r _line || [[ -n "$_line" ]]; do
          sessions+=("$_line")
        done < <("$TMUXBIN" list-sessions -F '#{session_name}' 2>/dev/null | sort -V)
      fi
      local target="${sessions[$((pick-1))]:-}"
      if [[ -z "$target" ]]; then
        echo "no session #$pick${repo:+ for ${repo}}. available:" >&2
        local i=1 s
        for s in ${sessions[@]+"${sessions[@]}"}; do echo "  $i) $s" >&2; ((i++)) || true; done
        exit 1
      fi
      exec "$TMUXBIN" attach -t "$target"
    else
      if "$TMUXBIN" has-session -t "=$pick" 2>/dev/null; then
        exec "$TMUXBIN" attach -t "=$pick"
      fi
      echo "no session named ${pick}. available:" >&2
      "$TMUXBIN" list-sessions -F '#{session_name}' 2>/dev/null | sort -V | sed 's/^/  /' >&2
      exit 1
    fi
  fi

  # --list
  if (( list )); then
    # bash 3.2-safe line read into array (order + blank lines preserved).
    local _line
    sessions=()
    if [[ -n "$repo" ]]; then
      # Scoped list still validates so vanished/corrupt trees are not silent empty.
      if ! validate_repo "$repo"; then
        exit 1
      fi
      while IFS= read -r _line || [[ -n "$_line" ]]; do
        sessions+=("$_line")
      done < <(_ferry_list_sessions_for_repo "$repo")
    else
      while IFS= read -r _line || [[ -n "$_line" ]]; do
        sessions+=("$_line")
      done < <("$TMUXBIN" list-sessions -F '#{session_name}' 2>/dev/null | sort -V)
    fi
    if (( ${#sessions[@]} == 0 )); then
      if [[ -n "$repo" ]]; then echo "no ${repo} sessions yet"; else echo "no tmux sessions running"; fi
      exit 0
    fi
    print_list
    exit 0
  fi

  # Typo guard: repo given but not a directory under base → error + list, never attach main.
  if [[ -n "$repo" ]]; then
    if ! validate_repo "$repo"; then
      exit 1
    fi
    dir="${FERRY_REPO_BASE}/${repo}"
  fi

  # --resume-closed / --resume-or-new: claim block (baseline, one blank-fallback change)
  if (( claim )); then
    if [[ -z "$repo" ]]; then
      echo "repo-session: --resume-closed/--resume-or-new require a <repo>" >&2
      exit 1
    fi
    if ! _ferry_repo_token_ok "$repo"; then
      echo "repo-session: invalid repo name ${repo}" >&2
      exit 1
    fi
    _list_repo_sessions
    local lockf now ttl target s n c
    lockf=$(_ferry_claim_lockf "$repo")
    _ferry_lock_acquire "$lockf"
    now=$(date +%s); ttl=25; target=""
    claimable() {   # not reserved by another pane in the last ttl seconds
      local c; c=$("$TMUXBIN" show-options -t "$1" -v -q @claim_ts 2>/dev/null)
      [[ -z "$c" ]] || (( now - c >= ttl ))
    }
    # pass 1: prefer a genuinely DETACHED session
    for s in ${sessions[@]+"${sessions[@]}"}; do
      [[ "$("$TMUXBIN" display-message -p -t "$s" '#{session_attached}')" == "0" ]] || continue
      claimable "$s" || continue
      target="$s"; "$TMUXBIN" set-option -t "$s" @claim_ts "$now" >/dev/null 2>&1; break
    done
    # pass 2: none detached → TAKE OVER an attached one.
    if [[ -z "$target" ]]; then
      for s in ${sessions[@]+"${sessions[@]}"}; do
        claimable "$s" || continue
        target="$s"; "$TMUXBIN" set-option -t "$s" @claim_ts "$now" >/dev/null 2>&1; break
      done
    fi
    if [[ -z "$target" && $fill -eq 1 ]]; then
      n=2; target="$repo"
      while "$TMUXBIN" has-session -t "$target" 2>/dev/null; do target="$repo-$n"; ((n++)) || true; done
      "$TMUXBIN" new-session -d -s "$target" -c "$dir"
      "$TMUXBIN" send-keys -t "$target" "${startcmd:-$FERRY_DEFAULT_CMD}" C-m
      "$TMUXBIN" set-option -t "$target" @claim_ts "$now" >/dev/null 2>&1
    fi
    _ferry_lock_release
    if [[ -n "$target" ]]; then exec "$TMUXBIN" attach -d -t "$target"; fi
    echo "no ${repo} sessions left to resume — blank shell" >&2
    # Blank fallback: plain login shell (no env -u SSH_CONNECTION; .bashrc auto-attach removed in Phase 2).
    exec "${SHELL:-/bin/bash}" -l
  fi

  # --primary: attach primary or create (baseline default, now explicit)
  if (( primary )); then
    if [[ -z "$repo" ]]; then
      echo "repo-session: --primary requires a <repo>" >&2
      exit 1
    fi
    if ! _ferry_repo_token_ok "$repo"; then
      echo "repo-session: invalid repo name ${repo}" >&2
      exit 1
    fi
    local session="$repo"
    local lockf
    lockf=$(_ferry_claim_lockf "$repo")
    _ferry_lock_acquire "$lockf"
    if ! "$TMUXBIN" has-session -t "$session" 2>/dev/null; then
      "$TMUXBIN" new-session -d -s "$session" -c "$dir"
      "$TMUXBIN" send-keys -t "$session" "${startcmd:-$FERRY_DEFAULT_CMD}" C-m
    fi
    _ferry_lock_release
    exec "$TMUXBIN" attach -t "$session"
  fi

  # --new: force fresh session
  if (( fresh )); then
    if [[ -z "$repo" ]]; then
      echo "repo-session: --new requires a <repo>" >&2
      exit 1
    fi
    if ! _ferry_repo_token_ok "$repo"; then
      echo "repo-session: invalid repo name ${repo}" >&2
      exit 1
    fi
    local session="$repo" n=2
    local lockf
    lockf=$(_ferry_claim_lockf "$repo")
    _ferry_lock_acquire "$lockf"
    while "$TMUXBIN" has-session -t "$session" 2>/dev/null; do
      session="$repo-$n"
      ((n++)) || true
    done
    "$TMUXBIN" new-session -d -s "$session" -c "$dir"
    "$TMUXBIN" send-keys -t "$session" "${startcmd:-$FERRY_DEFAULT_CMD}" C-m
    _ferry_lock_release
    exec "$TMUXBIN" attach -t "$session"
  fi

  # Default action / bare --resume: the picker.
  # Zero-session fast path when a repo is given and no live sessions exist.
  if [[ -n "$repo" ]]; then
    _list_repo_sessions
    if (( ${#sessions[@]} == 0 )); then
      echo "no live sessions for ${repo} — created primary"
      local session="$repo"
      local lockf
      lockf=$(_ferry_claim_lockf "$repo")
      _ferry_lock_acquire "$lockf"
      if ! "$TMUXBIN" has-session -t "$session" 2>/dev/null; then
        "$TMUXBIN" new-session -d -s "$session" -c "$dir"
        "$TMUXBIN" send-keys -t "$session" "${startcmd:-$FERRY_DEFAULT_CMD}" C-m
      fi
      _ferry_lock_release
      exec "$TMUXBIN" attach -t "$session"
    fi
  fi

  run_picker
}

# LIB mode: define helpers only (for unit tests / sourcing).
if [[ "${REPO_SESSION_LIB:-}" == "1" ]]; then
  # When sourced: return to caller. When executed with LIB=1: exit quietly.
  return 0 2>/dev/null || exit 0
fi

main "$@"
