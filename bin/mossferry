#!/usr/bin/env bash
# mossferry — local client: config, mosh/ssh launch, update, doctor
# shellcheck disable=SC1090,SC1091
set -u

# Symlink-safe path resolution (stock macOS bash 3.2 + Linux).
# Never depends on GNU `readlink -f` (absent on macOS without coreutils).
_ferry_resolve_self() {
  local src="${1:-${BASH_SOURCE[0]}}"
  local dir link max=50
  # Relative invocation → absolute first so -L checks work after cd.
  case "$src" in
    /*) ;;
    *) src="$(pwd)/$src" ;;
  esac
  while [ -L "$src" ] && [ "$max" -gt 0 ]; do
    dir=$(cd "$(dirname "$src")" && pwd) || return 1
    link=$(readlink "$src") || return 1
    case "$link" in
      /*) src=$link ;;
      *) src=$dir/$link ;;
    esac
    max=$((max - 1))
  done
  printf '%s\n' "$src"
}

_ferry_repo_root() {
  local self
  self=$(_ferry_resolve_self "${BASH_SOURCE[0]}") || return 1
  cd "$(dirname "$self")/.." && pwd
}

REPO_ROOT="$(_ferry_repo_root)"

# ---- GREEN-UI-KIT (vendored) — missing lib must NEVER kill the tool --------
_ferry_ui_fallbacks() {
  detect_color() { printf 'none\n'; }
  ui_tty() {
    case ${GREEN_UI_FORCE_TTY-} in
      1) return 0 ;;
      0) return 1 ;;
    esac
    [[ -t 2 ]]
  }
  ui_init() {
    GREEN_UI_MODE=none
    UI_R= UI_G= UI_Y= UI_B= UI_C= UI_M= UI_D= UI_BOLD= UI_Z= UI_A=
    UI_OK='OK' UI_ERR='XX' UI_WARN='!!' UI_PEND='..' UI_RUN='>>'
    UI_SPIN=('|' '/' '-' '\')
    return 0
  }
  banner() {
    local title=${1-} subtitle=${2-}
    printf '+-- %s --+\n' "$title" >&2
    [[ -n $subtitle ]] && printf '| %s\n' "$subtitle" >&2
  }
  ok()   { printf 'OK %s\n' "$*" >&2; }
  warn() { printf '!! %s\n' "$*" >&2; }
  die()  { printf 'XX %s\n' "${1-error}" >&2; exit "${2:-1}"; }
  panel() {
    local title=${1-} line
    printf '+-- %s --+\n' "$title" >&2
    while IFS= read -r line || [[ -n $line ]]; do
      printf '| %s\n' "$line" >&2
    done
    printf '+--------+\n' >&2
  }
  check_set() { printf '%s %s\n' "$2" "$3" >>"$1"; }
  checklist() {
    local sf=$1; shift
    local item id label last line g
    for item in "$@"; do
      id=${item%%:*}; label=${item#*:}; last=pending
      if [[ -f $sf ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
          [[ -z $line ]] && continue
          [[ ${line%% *} == "$id" ]] && last=${line#* }
        done <"$sf"
      fi
      case $last in done) g=OK ;; failed) g=XX ;; *) g=.. ;; esac
      printf '%s %s\n' "$g" "$label" >&2
    done
  }
  ui_cleanup() { return 0; }
}

_ferry_load_ui() {
  local kit="${REPO_ROOT}/lib/green-ui.sh"
  if [[ -r "$kit" ]]; then
    # shellcheck source=lib/green-ui.sh
    source "$kit" || _ferry_ui_fallbacks
  else
    _ferry_ui_fallbacks
  fi
  ui_init
}

_ferry_load_ui

# Shared repo-token shape gate (same charset as host validate_repo).
_ferry_load_repo_token() {
  local f="${REPO_ROOT}/lib/repo-token.sh"
  if [[ -r "$f" ]]; then
    # shellcheck source=lib/repo-token.sh
    source "$f" || true
  fi
  if ! declare -F _ferry_repo_token_ok >/dev/null 2>&1; then
    _ferry_repo_token_ok() {
      local r=${1-}
      [[ -n "$r" ]] || return 1
      case "$r" in
        /*|*/*|*\\*|*..*) return 1 ;;
      esac
      [[ "$r" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
      return 0
    }
    _ferry_repo_token_reject_msg() {
      local r=${1-}
      printf "repo-session: invalid repo name '%s'\n" "${r//\'/}" >&2
    }
  fi
}
_ferry_load_repo_token

# Client error line: always `mossferry:` prefix; red ✗ when TTY.
_ferry_err() {
  if ui_tty 2>/dev/null; then
    printf '%s%s%s mossferry: %s\n' "${UI_R-}" "${UI_ERR-✗}" "${UI_Z-}" "$*" >&2
  else
    printf 'mossferry: %s\n' "$*" >&2
  fi
}

own_version() {
  local f="$REPO_ROOT/VERSION" v
  if [[ -r "$f" ]]; then
    IFS= read -r v <"$f" || true
    # Strip UTF-8 BOM + CR so local X matches remote after the same strip.
    v=$(printf '%s' "${v:-unknown}" | sed $'s/^\xEF\xBB\xBF//' | tr -d '\r')
    printf '%s\n' "${v:-unknown}"
  else
    printf '%s\n' unknown
  fi
}

# ---- fleet-devlog v1 (opt-in, local-only; fail-open; never affects exit) ----
_ferry_load_devlog() {
  local f="${REPO_ROOT}/lib/fleet-devlog.sh"
  if [[ -r "$f" ]]; then
    # shellcheck source=lib/fleet-devlog.sh
    # shellcheck disable=SC1091
    . "$f" || true
  fi
  if ! declare -F devlog_emit >/dev/null 2>&1; then
    devlog_emit() { :; }
  fi
}
_ferry_load_devlog

# Emit one event for a finished subcommand. Never changes the caller's exit code.
_ferry_devlog_emit() {
  local cmd=${1-} rc=${2:-0} t0=${3:-0}
  local now ms=0 rclass=failed ver corr=""
  now=$(date +%s%N 2>/dev/null || date +%s000000000)
  if [[ "$now" =~ ^[0-9]+$ && "$t0" =~ ^[0-9]+$ ]]; then
    ms=$(( (now - t0) / 1000000 ))
    [[ $ms -lt 0 ]] && ms=0
  fi
  [[ "$rc" -eq 0 ]] 2>/dev/null && rclass=ok
  ver="$(own_version 2>/dev/null | tr -d '[:space:]' || true)"
  # FLEET_CORR is the only free-form-ish join key the contract allows
  if [[ -n "${FLEET_CORR-}" ]]; then
    corr="corr=${FLEET_CORR}"
  fi
  # Guarded: a devlog failure must never affect the tool
  devlog_emit "$cmd" "$rc" "$ms"     "tool_version=${ver}"     "result_class=${rclass}"     ${corr:+"$corr"}     2>/dev/null || true
  return 0
}

# env > config file > built-in default.
# Snapshot pre-set FERRY_* vars, apply defaults, source file, restore snapshot.
load_config() {
  local _had_remote_bin=0 _had_repo_base=0 _had_default_cmd=0
  local _had_default_host=0 _had_host_candidates=0 _had_server_timeout=0 _had_remote_repo=0
  local _had_banner=0 _had_wrap=0 _had_transport=0
  local _v_remote_bin _v_repo_base _v_default_cmd _v_default_host _v_host_candidates
  local _v_server_timeout _v_remote_repo _v_banner _v_wrap _v_transport

  if [[ -n "${FERRY_REMOTE_BIN+x}" ]]; then
    _had_remote_bin=1
    _v_remote_bin="$FERRY_REMOTE_BIN"
  fi
  if [[ -n "${FERRY_REPO_BASE+x}" ]]; then
    _had_repo_base=1
    _v_repo_base="$FERRY_REPO_BASE"
  fi
  if [[ -n "${FERRY_DEFAULT_CMD+x}" ]]; then
    _had_default_cmd=1
    _v_default_cmd="$FERRY_DEFAULT_CMD"
  fi
  if [[ -n "${FERRY_DEFAULT_HOST+x}" ]]; then
    _had_default_host=1
    _v_default_host="$FERRY_DEFAULT_HOST"
  fi
  if [[ -n "${FERRY_HOST_CANDIDATES+x}" ]]; then
    _had_host_candidates=1
    _v_host_candidates="$FERRY_HOST_CANDIDATES"
  fi
  if [[ -n "${FERRY_SERVER_TIMEOUT+x}" ]]; then
    _had_server_timeout=1
    _v_server_timeout="$FERRY_SERVER_TIMEOUT"
  fi
  if [[ -n "${FERRY_REMOTE_REPO+x}" ]]; then
    _had_remote_repo=1
    _v_remote_repo="$FERRY_REMOTE_REPO"
  fi
  if [[ -n "${FERRY_BANNER+x}" ]]; then
    _had_banner=1
    _v_banner="$FERRY_BANNER"
  fi
  if [[ -n "${FERRY_WRAP+x}" ]]; then
    _had_wrap=1
    _v_wrap="$FERRY_WRAP"
  fi
  if [[ -n "${FERRY_TRANSPORT+x}" ]]; then
    _had_transport=1
    _v_transport="$FERRY_TRANSPORT"
  fi

  FERRY_REMOTE_BIN=".local/bin/repo-session"
  FERRY_REPO_BASE="${HOME}/Repositories"
  FERRY_DEFAULT_CMD="neofetch"
  FERRY_DEFAULT_HOST=""
  # Optional comma-separated SSH host aliases for bare `ferry` / doctor / update
  # when no host is given. First BatchMode-reachable wins (e.g. LAN then Tailscale).
  # Explicit CLI hosts always win. IPs stay in the user's ~/.ssh/config — not here.
  FERRY_HOST_CANDIDATES=""
  FERRY_SERVER_TIMEOUT="86400"
  FERRY_REMOTE_REPO="Repositories/mossferry"
  FERRY_BANNER="on"
  # Local: prefix interactive mosh/ssh with `grok wrap` when available.
  # auto = wrap only if `grok` is on PATH; on = require wrap (warn + bare if missing);
  # off = never wrap. Does not apply to --list / doctor / update.
  FERRY_WRAP="auto"
  # Local interactive transport: mosh (default) or ssh. ssh + wrap is best for
  # Grok OSC 52 clipboard; mosh reconnects better but often strips OSC 52.
  FERRY_TRANSPORT="mosh"

  local cfg="${HOME}/.config/mossferry/config"
  if [[ -r "$cfg" ]]; then
    # Strip UTF-8 BOM so "KEY=value" is not a non-assignment command name.
    local _cfg_clean
    _cfg_clean=$(mktemp "${TMPDIR:-/tmp}/mossferry-cfg.XXXXXX") || _cfg_clean=""
    if [[ -n "$_cfg_clean" ]] && sed $'1s/^\xEF\xBB\xBF//' "$cfg" >"$_cfg_clean" 2>/dev/null; then
      # shellcheck source=/dev/null
      source "$_cfg_clean"
      rm -f "$_cfg_clean"
    else
      rm -f "$_cfg_clean" 2>/dev/null || true
      # shellcheck source=/dev/null
      source "$cfg"
    fi
  fi

  # Re-apply defaults for any keys the file left unset/empty only if still empty?
  # Spec: file wins over default; missing keys in file keep defaults we set above
  # before source — but source can unset. Re-fill only if completely unset.
  : "${FERRY_REMOTE_BIN:=.local/bin/repo-session}"
  : "${FERRY_REPO_BASE:=${HOME}/Repositories}"
  : "${FERRY_DEFAULT_CMD:=neofetch}"
  : "${FERRY_DEFAULT_HOST:=}"
  : "${FERRY_HOST_CANDIDATES:=}"
  : "${FERRY_SERVER_TIMEOUT:=86400}"
  : "${FERRY_REMOTE_REPO:=Repositories/mossferry}"
  : "${FERRY_BANNER:=on}"
  : "${FERRY_WRAP:=auto}"
  : "${FERRY_TRANSPORT:=mosh}"

  [[ $_had_remote_bin -eq 1 ]] && FERRY_REMOTE_BIN="$_v_remote_bin"
  [[ $_had_repo_base -eq 1 ]] && FERRY_REPO_BASE="$_v_repo_base"
  [[ $_had_default_cmd -eq 1 ]] && FERRY_DEFAULT_CMD="$_v_default_cmd"
  [[ $_had_default_host -eq 1 ]] && FERRY_DEFAULT_HOST="$_v_default_host"
  [[ $_had_host_candidates -eq 1 ]] && FERRY_HOST_CANDIDATES="$_v_host_candidates"
  [[ $_had_server_timeout -eq 1 ]] && FERRY_SERVER_TIMEOUT="$_v_server_timeout"
  [[ $_had_remote_repo -eq 1 ]] && FERRY_REMOTE_REPO="$_v_remote_repo"
  [[ $_had_banner -eq 1 ]] && FERRY_BANNER="$_v_banner"
  [[ $_had_wrap -eq 1 ]] && FERRY_WRAP="$_v_wrap"
  [[ $_had_transport -eq 1 ]] && FERRY_TRANSPORT="$_v_transport"
}

# Pick default SSH host for bare ferry / doctor / update.
# Priority: FERRY_HOST_CANDIDATES (first reachable) → FERRY_DEFAULT_HOST → empty.
# Explicit CLI host is never rewritten — only used when the operator omitted a host.
# Candidates are ssh config aliases (or raw hostnames); network paths (LAN vs
# Tailscale vs MagicDNS) live in the operator's ~/.ssh/config for flexibility.
resolve_default_host() {
  local list c first=""
  list="${FERRY_HOST_CANDIDATES:-}"
  if [[ -n "$list" ]]; then
    local IFS=','
    # shellcheck disable=SC2086
    set -- $list
    for c in "$@"; do
      # trim whitespace
      c="${c#"${c%%[![:space:]]*}"}"
      c="${c%"${c##*[![:space:]]}"}"
      [[ -z "$c" ]] && continue
      [[ -z "$first" ]] && first="$c"
      if ssh -o BatchMode=yes -o ConnectTimeout=2 \
        "$c" true >/dev/null 2>&1; then
        printf '%s\n' "$c"
        return 0
      fi
    done
    # None reachable: still return first candidate so callers emit a real host
    # in error messages / doctor (better than empty).
    if [[ -n "$first" ]]; then
      printf '%s\n' "$first"
      return 0
    fi
  fi
  if [[ -n "${FERRY_DEFAULT_HOST:-}" ]]; then
    printf '%s\n' "$FERRY_DEFAULT_HOST"
    return 0
  fi
  return 1
}

# ASCII ferry art for --help (and shared brand with remote picker).
# Keep in sync with bin/repo-session (deliberate duplication — both scripts stay self-contained).
# Keep in sync with bin/repo-session (deliberate duplication — both scripts stay self-contained).
# Optional arg = available display columns; default COLUMNS / tput / 80.
# Tiers: off→nothing; rows<18→SMALL; width≥52→WIDE; width≥24→MEDIUM; else SMALL.
ferry_banner() {
  case "${FERRY_BANNER:-on}" in
    off|0) return 0 ;;
  esac
  local rows width
  rows="${LINES:-$(tput lines 2>/dev/null || echo 24)}"
  width="${1:-${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}}"
  if (( rows < 18 )); then
    # Short panes: one-line variant (green name).
    printf '⛴ \033[1;32mmossferry\033[0m\n'
    return 0
  fi
  if (( width >= 52 )); then
    # WIDE: boat + figlet-wordmark lockup (6×51).
    # flag bright green; boat structure regular green; portholes/waves dim; figlet bright.
    printf '           \033[1;32m|>\033[0m\n'
    printf '\033[32m         __|__               \033[0m\033[1;32m__\033[0m\n'
    printf '\033[32m      __|_\033[0m\033[2;32mo\033[0m\033[32m_\033[0m\033[2;32mo\033[0m\033[32m_|__           \033[0m\033[1;32m/ _|___ _ _ _ _ _  _\033[0m\n'
    printf '\033[32m    _|___________|_        \033[0m\033[1;32m|  _/ -_) '"'"'_| '"'"'_| || |\033[0m\n'
    printf '\033[32m   \\   \033[0m\033[2;32mo\033[0m\033[32m   \033[0m\033[2;32mo\033[0m\033[32m   \033[0m\033[2;32mo\033[0m\033[32m   /       \033[0m\033[1;32m|_| \\___|_| |_|  \\_, |\033[0m\n'
    printf '\033[2;32m ~~~\033[0m\033[32m\\_____________/\033[0m\033[2;32m~~~~~~~~~~~~~~~~~~~~~~~~\033[0m\033[1;32m |__/\033[0m\033[2;32m ~~\033[0m\n'
    return 0
  fi
  if (( width >= 24 )); then
    # MEDIUM: boat liner with name on hull (6×22).
    printf '           \033[1;32m|>\033[0m\n'
    printf '\033[32m         __|__\033[0m\n'
    printf '\033[32m      __|_\033[0m\033[2;32mo\033[0m\033[32m_\033[0m\033[2;32mo\033[0m\033[32m_|__\033[0m\n'
    printf '\033[32m    _|___________|_\033[0m\n'
    printf '\033[32m   \\   \033[0m\033[1;32mmossferry\033[0m\033[32m   /\033[0m\n'
    printf '\033[2;32m ~~~\033[0m\033[32m\\_____________/\033[0m\033[2;32m~~~\033[0m\n'
    return 0
  fi
  # Narrow but tall: SMALL one-liner.
  printf '⛴ \033[1;32mmossferry\033[0m\n'
}

usage() {
  local ver
  ver="$(own_version | tr -d '[:space:]')"
  ferry_banner
  # Section labels green when TTY; body stays plain for pipe/grep stability.
  local H=$'\n' S="" Z=""
  if ui_tty 2>/dev/null && [[ ${GREEN_UI_MODE-none} != none ]]; then
    S="${UI_G-}${UI_BOLD-}"
    Z="${UI_Z-}"
  fi
  cat <<EOF
${S}Usage${Z}
  mossferry <host> [<repo>] [flags]   attach to a remote repo's tmux session (mosh/ssh)
  (\`ferry\` is the short command)

  Laptop client: resolves host, hops over mosh (default) or ssh, runs repo-session
  on the host. Default action is the session picker — nothing attaches a shared
  main session implicitly. Invalid repo tokens are rejected locally; missing
  repos pre-validate over ssh before mosh.

  ferry <host>                      global session picker
  ferry <host> <repo>               picker scoped to that repo basename
  ferry <host> <repo> -p            attach/create primary session
  ferry <host> --list               list sessions over ssh (no hop)
  ferry <host> --list-servers       list listeners (TSV); add --json
  ferry doctor [host]               read-only health (exit 1 if any FAIL)
  ferry update [host]               git pull local + remote; print versions
  ferry --help                      this help (local only; no network)

  # happy path — config: ~/.config/mossferry/config → FERRY_DEFAULT_HOST=workstation
  ferry doctor workstation
  ferry workstation                 # pick → enter attaches
  ferry workstation my-app -p       # primary attach/create

  Bare \`ferry\` uses FERRY_HOST_CANDIDATES (first BatchMode-reachable) or
  FERRY_DEFAULT_HOST. Put LAN vs remote aliases in ~/.ssh/config — ferry only
  tries the names you list (no hard-coded IPs).

${S}Picker${Z}
  enter=attach · ➕ new → nested start menu · ctrl-x=kill · ctrl-r=rename
  ctrl-s=servers face · esc=quit · list wraps (fzf --cycle)
  Start menu: FERRY_START_MENU (default claude,grok). Optional: FERRY_LAUNCHERS.
  Local wrap: FERRY_WRAP=auto + \`grok\` on PATH → \`grok wrap\` around the hop.
  Transport: FERRY_TRANSPORT=mosh|ssh (ssh = better OSC 52; no mosh roam).

${S}Flags${Z}
  --primary, -p      attach primary session, create if missing (needs <repo>)
  --new              fresh session name (repo, repo-2, …) (needs <repo>)
  --claude, -c       new sessions start \`claude\` (default start: neofetch)
  --list, -l         list sessions and exit (ssh; with <repo>: scoped)
  --list-servers     remote listeners (maps to repo-session --servers)
  --resume [N|name]  bare → picker; N → Nth; name → exact session attach
  --resume-closed    claim one EXISTING session (atomic; grid panes)
  --resume-or-new    claim or create until every grid pane has a session
  -- cmd...          custom start command for newly created sessions

${S}Config${Z}
  ~/.config/mossferry/config  (FERRY_* keys; env overrides file)
  docs/configuration.md · config.example · repo-session --help on the host

${S}Examples${Z}
  ferry workstation                        global session picker
  ferry workstation my-app                 scoped picker for my-app
  ferry workstation my-app --primary       attach/create the primary session
  ferry workstation my-app --new -c        fresh session running claude
  ferry workstation --list                 list every session (ssh)
  ferry update                             pull local + remote (default host)
  ferry doctor workstation                 health checks
  ghostty-grid -8 -- ferry workstation my-app --resume-or-new --claude

  Full flag list: docs/command-reference.md

mossferry ${ver} · the green ferry between your machines
EOF
}

cmd_update() {
  local host="${1:-}"
  if [[ -z "$host" ]]; then
    host="$(resolve_default_host)" || host=""
  fi
  if [[ -z "$host" ]]; then
    _ferry_err "update: no host (pass one, or set FERRY_HOST_CANDIDATES / FERRY_DEFAULT_HOST)"
    return 1
  fi

  local chrome=0
  if ui_tty 2>/dev/null; then
    chrome=1
    banner "ferry update" "$host"
  fi

  # Local pull (no set -e; branch may lack upstream mid-development).
  if (( chrome )); then
    printf '%s%s%s local pull…\n' "${UI_C-}" "${UI_RUN->>}" "${UI_Z-}" >&2
  fi
  local local_ec=0 git_tmp
  if (( chrome )) && [[ -z ${FERRY_UPDATE_VERBOSE-} ]]; then
    git_tmp=$(mktemp 2>/dev/null || printf '/tmp/ferry-update.%s' "$$")
    if git -C "$REPO_ROOT" pull --ff-only >"$git_tmp" 2>&1; then
      local_ec=0
    else
      local_ec=$?
    fi
    while IFS= read -r line || [[ -n ${line-} ]]; do
      [[ -z ${line-} ]] && continue
      printf '%s%s%s\n' "${UI_D-}" "$line" "${UI_Z-}" >&2
    done <"$git_tmp"
    rm -f "$git_tmp"
  else
    git -C "$REPO_ROOT" pull --ff-only || local_ec=$?
  fi
  if (( local_ec != 0 )); then
    _ferry_err "update: local pull failed (continuing)"
    (( chrome )) && printf '%s%s%s local pull\n' "${UI_Y-}" "${UI_WARN-!!}" "${UI_Z-}" >&2
  else
    (( chrome )) && printf '%s%s%s local pull\n' "${UI_G-}" "${UI_OK-OK}" "${UI_Z-}" >&2
  fi

  # Canonical remote checkout (no remotes, or branch has no upstream) cannot pull —
  # skip and continue. Detect upstream via rev-parse @{u} (nonzero = no upstream).
  if (( chrome )); then
    printf '%s%s%s remote pull…\n' "${UI_C-}" "${UI_RUN->>}" "${UI_Z-}" >&2
  fi
  local remotes remote_skipped=0 remote_ec=0
  if ! remotes="$(ssh "$host" git -C "$FERRY_REMOTE_REPO" remote)"; then
    _ferry_err "update: remote pull failed"
    (( chrome )) && printf '%s%s%s remote pull\n' "${UI_R-}" "${UI_ERR-XX}" "${UI_Z-}" >&2
    return 1
  fi
  remotes="${remotes//$'\r'/}"
  if [[ -z "$remotes" ]]; then
    printf '%s\n' "remote checkout is canonical (no upstream) — pull skipped"
    remote_skipped=1
  elif ! ssh "$host" git -C "$FERRY_REMOTE_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    printf '%s\n' "remote checkout is canonical (no upstream) — pull skipped"
    remote_skipped=1
  else
    if (( chrome )) && [[ -z ${FERRY_UPDATE_VERBOSE-} ]]; then
      git_tmp=$(mktemp 2>/dev/null || printf '/tmp/ferry-update-r.%s' "$$")
      if ssh "$host" git -C "$FERRY_REMOTE_REPO" pull --ff-only >"$git_tmp" 2>&1; then
        remote_ec=0
      else
        remote_ec=$?
      fi
      while IFS= read -r line || [[ -n ${line-} ]]; do
        [[ -z ${line-} ]] && continue
        printf '%s%s%s\n' "${UI_D-}" "$line" "${UI_Z-}" >&2
      done <"$git_tmp"
      rm -f "$git_tmp"
      if (( remote_ec != 0 )); then
        _ferry_err "update: remote pull failed"
        printf '%s%s%s remote pull\n' "${UI_R-}" "${UI_ERR-XX}" "${UI_Z-}" >&2
        return 1
      fi
    else
      ssh "$host" git -C "$FERRY_REMOTE_REPO" pull --ff-only || {
        _ferry_err "update: remote pull failed"
        return 1
      }
    fi
  fi
  if (( chrome )); then
    if (( remote_skipped )); then
      printf '%s%s%s remote pull (skipped)\n' "${UI_D-}" "${UI_PEND-..}" "${UI_Z-}" >&2
    else
      printf '%s%s%s remote pull\n' "${UI_G-}" "${UI_OK-OK}" "${UI_Z-}" >&2
    fi
  fi

  local v_local v_remote
  v_local="$(own_version | tr -d '[:space:]')"
  v_remote="$(ssh "$host" cat "${FERRY_REMOTE_REPO}/VERSION")"
  # Strip CR/LF/space and UTF-8 BOM so equal versions compare equal.
  v_remote=$(printf '%s' "$v_remote" | sed $'s/^\xEF\xBB\xBF//' | tr -d '\r\n[:space:]')

  # Parse-token law: non-TTY (and always) print the slash form on stdout.
  printf 'local %s / remote %s\n' "$v_local" "$v_remote"

  # TTY wave strip on stderr (chrome).
  if (( chrome )); then
    local wave color
    if [[ "$v_local" == "$v_remote" ]]; then
      color="${UI_G-}"
      wave="local ${v_local} ~~~⛴~~~ remote ${v_remote}"
    else
      color="${UI_R-}"
      wave="local ${v_local} ~~~⛴~~~ remote ${v_remote}"
    fi
    printf '%s%s%s\n' "$color" "$wave" "${UI_Z-}" >&2
  fi
}

cmd_doctor() {
  local host="${1:-}"
  if [[ -z "$host" ]]; then
    host="$(resolve_default_host)" || host=""
  fi
  if [[ -z "$host" ]]; then
    _ferry_err "doctor: no host (pass one, or set FERRY_HOST_CANDIDATES / FERRY_DEFAULT_HOST)"
    return 1
  fi

  local failed=0 checks=0 cfg="${HOME}/.config/mossferry/config"
  local chrome=0 version_failed=0
  local fix_hints=()
  # Shared options for every remote-connecting probe. BatchMode + ConnectTimeout
  # guarantee no check can block on an interactive password prompt. connect_ok
  # gates remote checks so they are skipped (not hung) when the connect probe failed.
  local connect_ok=0
  local -a SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=5)

  if ui_tty 2>/dev/null; then
    chrome=1
    # SMALL one-liner banner tier for doctor
    printf '⛴ %s%smossferry doctor%s · %s\n' "${UI_G-}${UI_BOLD-}" "${UI_Z-}${UI_G-}" "${UI_Z-}" "$host" >&2
  fi

  # Emit one check line. kind = ok|FAIL|info. Non-TTY: exact tokens. TTY: glyph + line.
  _doc_emit() {
    local kind=$1
    shift
    local msg="$*"
    checks=$((checks + 1))
    if (( chrome )); then
      case "$kind" in
        ok)
          printf '%s%s%s ok %s\n' "${UI_G-}" "${UI_OK-OK}" "${UI_Z-}" "$msg"
          ;;
        FAIL)
          printf '%s%s%s FAIL %s\n' "${UI_R-}" "${UI_ERR-XX}" "${UI_Z-}" "$msg"
          ;;
        info)
          printf '%sinfo %s%s\n' "${UI_D-}" "$msg" "${UI_Z-}"
          ;;
        *)
          printf '%s %s\n' "$kind" "$msg"
          ;;
      esac
    else
      printf '%s %s\n' "$kind" "$msg"
    fi
  }

  # 1. config readable (info if absent)
  if [[ -r "$cfg" ]]; then
    _doc_emit ok "config readable: $cfg"
  else
    _doc_emit info "config absent — defaults in use"
  fi

  # 2. ssh -G resolves
  if ssh -G "$host" >/dev/null 2>&1; then
    _doc_emit ok "ssh config resolves host $host"
  else
    _doc_emit FAIL "ssh config does not resolve host $host"
    failed=1
  fi

  # 3. ssh BatchMode connect
  if ssh "${SSH_OPTS[@]}" "$host" true >/dev/null 2>&1; then
    _doc_emit ok "ssh BatchMode connect to $host"
    connect_ok=1
  else
    _doc_emit FAIL "ssh BatchMode connect to $host"
    failed=1
  fi

  # 4. local mosh binary
  if command -v mosh >/dev/null 2>&1; then
    _doc_emit ok "local mosh binary"
  else
    _doc_emit FAIL "local mosh binary missing"
    failed=1
  fi

  # 4b. local grok wrap (clipboard / terminal restore for remote TUIs)
  local wrap_mode="${FERRY_WRAP:-auto}"
  case "$wrap_mode" in
    off|0|false|no)
      _doc_emit info "FERRY_WRAP=$wrap_mode — not prefixing transport with grok wrap"
      ;;
    *)
      if command -v grok >/dev/null 2>&1 && grok wrap -h >/dev/null 2>&1; then
        _doc_emit ok "local grok wrap available (FERRY_WRAP=$wrap_mode)"
      elif [[ "$wrap_mode" == on || "$wrap_mode" == 1 || "$wrap_mode" == true || "$wrap_mode" == yes ]]; then
        _doc_emit FAIL "FERRY_WRAP=$wrap_mode but grok not on PATH (curl -fsSL https://x.ai/cli/install.sh | bash)"
        failed=1
      else
        _doc_emit info "grok not on PATH — interactive ferry will not use grok wrap (install Grok CLI on this machine)"
      fi
      ;;
  esac

  # 4c. transport preference
  case "${FERRY_TRANSPORT:-mosh}" in
    ssh|SSH)
      _doc_emit info "FERRY_TRANSPORT=ssh (interactive; better OSC 52 with wrap, no mosh roam)"
      ;;
    mosh|MOSH|"")
      _doc_emit info "FERRY_TRANSPORT=mosh (default; OSC 52 often stripped — keep host clipboard pipes if needed)"
      ;;
    *)
      _doc_emit FAIL "FERRY_TRANSPORT=${FERRY_TRANSPORT} (want mosh|ssh)"
      failed=1
      ;;
  esac

  # When connect failed, remote probes cannot succeed — skip them (no hang) and
  # emit the same FAIL/info tokens a failed probe would have produced.
  if (( ! connect_ok )); then
    _doc_emit info "remote checks skipped — ssh BatchMode connect failed"
  fi

  # 5. remote FERRY_REMOTE_BIN executable (relative to remote $HOME)
  if (( connect_ok )) && ssh "${SSH_OPTS[@]}" "$host" "test -x $FERRY_REMOTE_BIN || test -x \"\$HOME/$FERRY_REMOTE_BIN\"" >/dev/null 2>&1; then
    _doc_emit ok "remote $FERRY_REMOTE_BIN executable"
  else
    _doc_emit FAIL "remote $FERRY_REMOTE_BIN not executable"
    failed=1
  fi

  # 6. local vs remote VERSION match
  local v_local v_remote=""
  v_local="$(own_version | tr -d '[:space:]')"
  if (( connect_ok )); then
    v_remote="$(ssh "${SSH_OPTS[@]}" "$host" cat "${FERRY_REMOTE_REPO}/VERSION" 2>/dev/null || true)"
    v_remote=$(printf '%s' "$v_remote" | sed $'s/^\xEF\xBB\xBF//' | tr -d '\r\n[:space:]')
  fi
  if [[ -n "$v_remote" && "$v_local" == "$v_remote" ]]; then
    _doc_emit ok "versions match: $v_local"
  else
    _doc_emit FAIL "versions: local $v_local / remote ${v_remote:-unknown}"
    failed=1
    version_failed=1
    fix_hints+=("run: ferry update ${host}")
  fi

  # 7. remote fzf (info if missing)
  if (( connect_ok )) && ssh "${SSH_OPTS[@]}" "$host" command -v fzf >/dev/null 2>&1; then
    _doc_emit ok "remote fzf present"
  else
    _doc_emit info "remote fzf missing — numbered menu fallback available"
  fi

  # 8. remote mosh-server count (info)
  local count=""
  if (( connect_ok )); then
    count="$(ssh "${SSH_OPTS[@]}" "$host" pgrep -c mosh-server 2>/dev/null || true)"
  fi
  count="${count//$'\n'/}"
  : "${count:=0}"
  _doc_emit info "remote mosh-server count: $count"

  # 9. MagicDNS note (info): whether HostName is an IP (local resolver — always runs)
  local hostname
  hostname="$(ssh -G "$host" 2>/dev/null | awk 'tolower($1)=="hostname"{print $2; exit}')"
  if [[ -z "$hostname" ]]; then
    _doc_emit info "MagicDNS: could not read HostName for $host"
  elif [[ "$hostname" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    _doc_emit info "MagicDNS: HostName is IP ($hostname) — not using MagicDNS name"
  else
    _doc_emit info "MagicDNS: HostName is $hostname"
  fi

  # 10. Mac host + reserved ports + servers summary (info only — never changes exit code)
  local mac_host reserved_list n_listen n_missing n_foreign srv_summary
  mac_host=""
  if command -v preview-host >/dev/null 2>&1; then
    mac_host="$(preview-host 2>/dev/null | head -1 | tr -d '\r')" || mac_host=""
  fi
  if [[ -n "$mac_host" ]]; then
    _doc_emit info "Mac-reachable host: $mac_host"
  else
    _doc_emit info "Mac-reachable host: (preview-host not on PATH)"
  fi
  reserved_list="${FERRY_SERVERS_RESERVED:-8791 3001 5432 6379 27017 8080 5173 3000}"
  _doc_emit info "reserved ports: $reserved_list"
  # Best-effort remote servers summary; never fail doctor on discovery errors
  srv_summary=""
  if (( connect_ok )); then
    srv_summary="$(ssh "${SSH_OPTS[@]}" "$host" "$FERRY_REMOTE_BIN" --servers 2>/dev/null | awk -F'\t' '
      $2=="LISTEN"{l++}
      $2=="declared-missing"{m++}
      $2=="FOREIGN"{f++}
      END{printf "%d LISTEN · %d declared-missing · %d foreign", l+0, m+0, f+0}
    ' || true)"
  fi
  if [[ -n "$srv_summary" ]]; then
    _doc_emit info "servers: $srv_summary"
  else
    _doc_emit info "servers: (unavailable — remote --servers not present or empty)"
  fi

  # TTY summary + fix hints
  if (( chrome )); then
    if (( failed )); then
      printf '%s%d checks · %s failed%s\n' "${UI_R-}" "$checks" "some" "${UI_Z-}" >&2
    else
      printf '%s%s%s %d checks · all ok%s\n' "${UI_G-}" "${UI_OK-OK}" "${UI_Z-}" "$checks" "" >&2
    fi
    local h
    for h in "${fix_hints[@]+"${fix_hints[@]}"}"; do
      printf '%s%s%s\n' "${UI_D-}" "$h" "${UI_Z-}" >&2
    done
  fi

  return "$failed"
}

# First non-flag token after host is the repo (stops at `--`).
# Empty when bare picker / flag-only / cmd-only.
repo_token_from_args() {
  local a
  for a in "$@"; do
    if [[ "$a" == "--" ]]; then
      return 0
    fi
    case "$a" in
      -*) continue ;;
      *)
        printf '%s\n' "$a"
        return 0
        ;;
    esac
  done
}

# True when interactive transport should run under `grok wrap`.
# Local-only: wrap intercepts OSC 52 for Mac clipboard + cleans dirty TUI exits.
# Remote AI launchers (ctrl-g → grok) are orthogonal — they set the start command
# inside tmux; wrap must already surround the whole ferry hop from this machine.
_ferry_should_wrap() {
  case "${FERRY_WRAP:-auto}" in
    off|0|false|no) return 1 ;;
    on|1|true|yes)
      if command -v grok >/dev/null 2>&1; then
        return 0
      fi
      _ferry_err "FERRY_WRAP=on but grok not on PATH — launching without wrap (install: curl -fsSL https://x.ai/cli/install.sh | bash)"
      return 1
      ;;
    auto|*)
      command -v grok >/dev/null 2>&1
      ;;
  esac
}

# Run interactive transport, optionally: grok wrap <mosh|ssh> ...
_ferry_run_transport() {
  if _ferry_should_wrap; then
    grok wrap "$@"
    return $?
  fi
  "$@"
  return $?
}

# Build a single remote command string with shell-quoted tokens.
# OpenSSH joins multiple post-host args with bare spaces (no quoting), so
# repo names with spaces or quotes must be printf-%q'd into one remote string.
_ferry_ssh_remote_cmd() {
  local out="" a
  for a in "$@"; do
    out+="$(printf '%q' "$a") "
  done
  printf '%s' "${out% }"
}

# ssh host with fully quoted remote argv (fail-closed on empty host).
_ferry_ssh_quoted() {
  local host=$1
  shift
  [[ -n "$host" ]] || return 1
  ssh "$host" "$(_ferry_ssh_remote_cmd "$@")"
}

# Launch remote: ssh for --list/-l; interactive mosh (default) or ssh (FERRY_TRANSPORT).
# Prepends --client-version <v> before user args.
# Shape-invalid repo tokens are rejected locally (no ssh). Existence still
# pre-validates over ssh before mosh so missing-repo errors print without a hop.
# Interactive hops use FERRY_WRAP (auto → grok wrap when local grok exists).
launch_remote() {
  local host="$1"
  shift
  local ver a repo val_out val_rc=0 transport remote_cmd
  ver="$(own_version)"

  for a in "$@"; do
    case "$a" in
      -h|--help)
        usage
        return 0
        ;;
    esac
  done

  # Local shape gate first — same charset as host _ferry_repo_token_ok.
  # A typo with spaces or path characters must not reach DNS/ssh.
  repo="$(repo_token_from_args "$@")"
  if [[ -n "$repo" ]] && ! _ferry_repo_token_ok "$repo"; then
    _ferry_repo_token_reject_msg "$repo"
    return 1
  fi

  for a in "$@"; do
    case "$a" in
      --list|-l)
        # Non-interactive listing — never wrap (no TUI / no OSC 52).
        _ferry_ssh_quoted "$host" "$FERRY_REMOTE_BIN" --client-version "$ver" "$@"
        return $?
        ;;
      --list-servers)
        # Non-interactive servers view on remote (maps to repo-session --servers).
        local remote_args=() a
        for a in "$@"; do
          if [[ "$a" == "--list-servers" ]]; then
            remote_args+=(--servers)
          else
            remote_args+=("$a")
          fi
        done
        _ferry_ssh_quoted "$host" "$FERRY_REMOTE_BIN" --client-version "$ver" "${remote_args[@]}"
        return $?
        ;;
    esac
  done

  if [[ -n "$repo" ]]; then
    val_out="$(_ferry_ssh_quoted "$host" "$FERRY_REMOTE_BIN" --client-version "$ver" --validate "$repo" 2>&1)" || val_rc=$?
    if [[ $val_rc -ne 0 ]]; then
      [[ -n "$val_out" ]] && printf '%s\n' "$val_out" >&2
      return 1
    fi
  fi

  remote_cmd=$(_ferry_ssh_remote_cmd "$FERRY_REMOTE_BIN" --client-version "$ver" "$@")
  transport="${FERRY_TRANSPORT:-mosh}"
  case "$transport" in
    ssh|SSH)
      _ferry_run_transport ssh -t "$host" "$remote_cmd"
      return $?
      ;;
    mosh|MOSH|"")
      _ferry_run_transport mosh \
        --server="MOSH_SERVER_NETWORK_TMOUT=${FERRY_SERVER_TIMEOUT} mosh-server" \
        "$host" -- bash -lc "$remote_cmd"
      return $?
      ;;
    *)
      _ferry_err "unknown FERRY_TRANSPORT='$transport' (want mosh|ssh)"
      return 1
      ;;
  esac
}

main() {
  load_config

  # Snapshot argv for fleet-devlog --no-devlog detection (array, not exported).
  DEVLOG_ARGV=("$@")
  local _dl_t0 _dl_rc=0 _dl_cmd=""
  _dl_t0=$(date +%s%N 2>/dev/null || date +%s000000000)

  # Subcommand / zero-arg dispatch before host parsing.
  if [[ $# -eq 0 ]]; then
    local _def
    if _def="$(resolve_default_host)"; then
      set -- "$_def"
    else
      usage >&2
      _dl_rc=1
      _ferry_devlog_emit help "$_dl_rc" "$_dl_t0" || true
      return "$_dl_rc"
    fi
  fi

  case "$1" in
    -h|--help)
      usage
      _dl_rc=0
      _ferry_devlog_emit help "$_dl_rc" "$_dl_t0" || true
      return "$_dl_rc"
      ;;
    update)
      shift
      cmd_update "$@"
      _dl_rc=$?
      _ferry_devlog_emit update "$_dl_rc" "$_dl_t0" || true
      return "$_dl_rc"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      _dl_rc=$?
      _ferry_devlog_emit doctor "$_dl_rc" "$_dl_t0" || true
      return "$_dl_rc"
      ;;
  esac

  local host="$1"
  shift
  launch_remote "$host" "$@"
  _dl_rc=$?
  _ferry_devlog_emit session "$_dl_rc" "$_dl_t0" || true
  return "$_dl_rc"
}

if [[ "${FERRY_LIB:-}" == "1" ]]; then
  # Sourced as a library: expose load_config / own_version / usage / main.
  return 0 2>/dev/null || true
else
  main "$@"
  exit $?
fi
